  src '      gv_name(150) TYPE c,'.
  src '      gv_setup(1)  TYPE c,'.
  src '      gv_auth(1)   TYPE c.'.
  src 'DATA: gt_allowed TYPE RANGE OF zche_imap_log-profile,'.
