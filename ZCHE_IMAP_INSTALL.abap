  src '  ls_mail-mailuid     = iv_uid.'.
  src '  PERFORM set_status USING ls_mail ''S'' space'.
  src '                     CHANGING lv_status lv_logmsg.'.
  src '  IF lv_status IS INITIAL.'.
  src '    gv_fail = gv_fail + 1.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  FORMAT COLOR COL_POSITIVE INTENSIFIED OFF.'.
  src '  WRITE: / ''  UID'', lv_uidc, ''completed.''.'.
  src '  FORMAT COLOR OFF.'.
  src '  gv_done = gv_done + 1.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM set_status USING is_mail   TYPE zche_imap_s_mail'.
  src '                      iv_status TYPE c'.
  src '                      iv_msg    TYPE c'.
  src '                CHANGING cv_ok TYPE c cv_msg TYPE c.'.
  src '  DATA: ls_log TYPE zche_imap_log,'.
  src '        lt_marker TYPE ty_t_line,'.
  src '        ls_marker TYPE zche_imap_s_line,'.
  src '        lv_dir(255) TYPE c, lv_path(255) TYPE c,'.
  src '        lv_marker_ok TYPE c, lv_marker_msg(255) TYPE c.'.
  src ''.
  src '  CLEAR: cv_ok, cv_msg.'.
  src '  IF NOT p_test IS INITIAL.'.
  src '    cv_ok = ''X''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src ''.
  src '  SELECT SINGLE * FROM zche_imap_log INTO ls_log'.
  src '    WHERE profile     = is_mail-profile'.
  src '      AND uidvalidity = is_mail-uidvalidity'.
  src '      AND mailuid     = is_mail-mailuid.'.
  src '  IF sy-subrc <> 0.'.
  src '    CLEAR ls_log.'.
  src '    ls_log-profile     = is_mail-profile.'.
  src '    ls_log-uidvalidity = is_mail-uidvalidity.'.
  src '    ls_log-mailuid     = is_mail-mailuid.'.
  src '  ENDIF.'.
  src '  IF NOT is_mail-subject IS INITIAL OR'.
  src '     NOT is_mail-sender IS INITIAL.'.
  src '    ls_log-sender    = is_mail-sender.'.
  src '    ls_log-subject   = is_mail-subject.'.
  src '    ls_log-messageid = is_mail-messageid.'.
  src '    ls_log-maildate  = is_mail-maildate.'.
  src '    ls_log-attcnt    = is_mail-attcnt.'.
  src '  ENDIF.'.
  src '  IF iv_status = ''E'' AND ls_log-attempts < 9999.'.
  src '    ls_log-attempts = ls_log-attempts + 1.'.
  src '  ENDIF.'.
  src '  ls_log-status  = iv_status.'.
  src '  ls_log-message = iv_msg.'.
  src '  ls_log-chdat   = sy-datum.'.
  src '  ls_log-chtim   = sy-uzeit.'.
  src '  ls_log-uname   = sy-uname.'.
  src '  MODIFY zche_imap_log FROM ls_log.'.
  src '  IF sy-subrc <> 0.'.
  src '    ROLLBACK WORK.'.
  src '    cv_msg = ''Could not persist mail status; no move attempted'.
  cnt '''.'.
  src '    WRITE: / cv_msg.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  COMMIT WORK AND WAIT.'.
  src '  IF sy-subrc <> 0.'.
  src '    cv_msg = ''Mail transaction failed; no move attempted''.'.
  src '    WRITE: / cv_msg.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF iv_status = ''E''.'.
  src '    PERFORM mail_dir USING space is_mail-profile'.
  src '      is_mail-uidvalidity is_mail-mailuid CHANGING lv_dir.'.
  src '    CONCATENATE lv_dir ''failed.utc'' INTO lv_path.'.
  src '    ls_marker-text = ''E''.'.
  src '    APPEND ls_marker TO lt_marker.'.
  src '    PERFORM write_text_file USING lv_path lt_marker'.
  src '      CHANGING lv_marker_ok lv_marker_msg.'.
  src '  ENDIF.'.
  src '  cv_ok = ''X''.'.
  src 'ENDFORM.'.
ENDFORM.

