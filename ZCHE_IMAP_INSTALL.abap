  src '    WHERE profile IN s_prof.'.
  src '  LOOP AT gt_profiles INTO gs_profile.'.
  src '    PERFORM profile_auth USING gs_profile-profile ''03'''.
  src '                         CHANGING gv_auth.'.
  src '    IF gv_auth = ''X''.'.
  src '      gs_allowed-sign = ''I''.'.
  src '      gs_allowed-option = ''EQ''.'.
  src '      gs_allowed-low = gs_profile-profile.'.
  src '      APPEND gs_allowed TO gt_allowed.'.
  src '    ENDIF.'.
  src '  ENDLOOP.'.
  src '  IF gt_allowed IS INITIAL.'.
  src '    WRITE: / ''No authorized profiles''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  SELECT * FROM zche_imap_log INTO TABLE gt_log'.
  src '    UP TO p_limit ROWS'.
  src '    WHERE profile IN gt_allowed'.
  src '      AND status  IN s_stat'.
  src '      AND chdat   IN s_date'.
  src '    ORDER BY chdat DESCENDING chtim DESCENDING'.
  src '             profile uidvalidity mailuid.'.
  src '  SORT gt_log BY chdat DESCENDING chtim DESCENDING.'.
  src '  PERFORM write_list.'.
  src '  WRITE: / ''Display limited to'', p_limit,'.
  src '           ''rows; narrow profile/date selections for older mai'.
  cnt 'l.''.'.
  src ''.
  src 'TOP-OF-PAGE.'.
  src '  FORMAT COLOR COL_HEADING.'.
  src '  WRITE: / ''Status'', 12 ''Profile'', 33 ''UID'', 45 ''Date'','.
  cnt ' 56 ''Time'','.
  src '           65 ''From'', 106 ''Subject'', 157 ''Att.''.'.
  src '  FORMAT COLOR OFF.'.
  src '  ULINE.'.
  src ''.
