  src '  lv_file = lv_fstr.'.
  src ''.
  src '* ABAP 7.00 frontend API accepts a STRING filename.'.
  src '  CALL FUNCTION ''GUI_DOWNLOAD'''.
  src '    EXPORTING bin_filesize = lv_len filename = lv_fstr'.
