  src '  IF sy-subrc <> 0.'.
  src '    PERFORM show_msg USING ''S'''.
  src '      ''New profile: fill in the fields, then Save or F8.''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  p_descr = ls_prof-descr.'.
  src '  p_act   = ls_prof-active.'.
  src '  p_host  = ls_prof-host.'.
  src '  p_port  = ls_prof-port.'.
  src '  p_sec   = ls_prof-security.'.
  src '  p_ver   = ls_prof-verify.'.
  src '  p_user  = ls_prof-username.'.
  src '  p_crsrc = ls_prof-credsrc.'.
  src '  p_mbox  = ls_prof-mailbox.'.
  src '  p_done  = ls_prof-donebox.'.
  src '  p_move  = ls_prof-movemode.'.
  src '  p_hprog = ls_prof-hprog.'.
  src '  p_hform = ls_prof-hform.'.
  src '  p_maxm  = ls_prof-maxmail.'.
  src '  p_maxmb = ls_prof-maxmb.'.
  src '  p_tout  = ls_prof-timeout.'.
  src '  p_ret   = ls_prof-retdays.'.
  src '  CLEAR p_pwd.'.
  src '  PERFORM show_msg USING ''S'' ''Profile loaded.''.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM save_on_screen.'.
  src '  DATA: lv_ok(1)    TYPE c,'.
  src '        lv_msg(200) TYPE c.'.
  src ''.
  src '  PERFORM save_profile CHANGING lv_ok lv_msg.'.
  src '  IF lv_ok IS INITIAL.'.
  src '    PERFORM show_msg USING ''E'' lv_msg.'.
  src '  ELSE.'.
  src '    PERFORM show_msg USING ''S'' lv_msg.'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src '* Validates, writes to the table and to the conf file on the'.
  src '* server; writes the secret file if a password was entered.'.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM save_profile CHANGING cv_ok  TYPE c'.
  src '                           cv_msg TYPE c.'.
  src '  CLEAR: cv_ok, cv_msg.'.
  src '  PERFORM profile_auth USING p_prof ''02'' CHANGING cv_ok.'.
  src '  IF cv_ok IS INITIAL.'.
  src '    cv_msg = ''Not authorized to change this profile''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  PERFORM table_auth USING ''ZCHE_IMAP_PROF'' ''U'' CHANGING cv'.
  cnt '_ok.'.
  src '  IF cv_ok IS INITIAL.'.
  src '    cv_msg = ''No profile change authorization (S_TABU_DIS).''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  PERFORM profile_valid USING p_prof CHANGING cv_ok.'.
  src '  IF cv_ok IS INITIAL.'.
  src '    cv_msg = ''Profile: A-Z, digits, underscore; no spaces.''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  PERFORM profile_lock USING p_prof CHANGING cv_ok.'.
  src '  IF cv_ok IS INITIAL.'.
  src '    cv_msg = ''Profile in use or lock unavailable; try again.'''.
  cnt '.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  PERFORM save_profile_locked CHANGING cv_ok cv_msg.'.
  src '  PERFORM profile_unlock USING p_prof.'.
  src 'ENDFORM.'.
  src ''.
  src 'FORM save_profile_locked CHANGING cv_ok TYPE c cv_msg TYPE c.'.
  src '  DATA: ls_prof    TYPE zche_imap_prof,'.
  src '        ls_old     TYPE zche_imap_prof,'.
  src '        lv_new(1)  TYPE c,'.
  src '        lv_name(40) TYPE c,'.
  src '        lv_chars(80) TYPE c,'.
  src '        lv_logged LIKE zche_imap_log-profile,'.
  src '        lv_revision TYPE p DECIMALS 0,'.
  src '        lv_source(100) TYPE c,'.
  src '        lv_target(100) TYPE c,'.
  src '        lv_mlen TYPE i,'.
  src '        lv_dlen TYPE i,'.
  src '        lv_allowed(1) TYPE c.'.
  src ''.
  src '  CLEAR: cv_ok, cv_msg.'.
  src '  IF p_crsrc = ''S'' AND NOT p_pwd IS INITIAL.'.
  src '    IF gv_pwdguard IS INITIAL OR NOT sy-batch IS INITIAL.'.
  src '      CLEAR p_pwd.'.
  src '      cv_msg = ''New password entry unavailable; use Basis sour'.
  cnt 'ce O.''.'.
  src '      EXIT.'.
  src '    ENDIF.'.
  src '  ENDIF.'.
  src '  IF gv_setup IS INITIAL.'.
  src '    cv_msg = ''Setup missing/wrong host: rerun ZCHE_IMAP_INSTAL'.
  cnt 'L.''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF p_prof IS INITIAL OR'.
  src '     NOT p_prof CO ''ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_ ''.'.
  src '    cv_msg = ''Profile name: capitals, digits and _ (max 20).'''.
  cnt '.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF p_host IS INITIAL.'.
  src '    cv_msg = ''Enter the mail server.''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF p_port IS INITIAL.'.
  src '    cv_msg = ''Enter the port (IMAPS 993, STARTTLS/NONE 143).'''.
  cnt '.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF p_user IS INITIAL.'.
  src '    cv_msg = ''Enter the mail user name.''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF p_crsrc <> ''S'' AND p_crsrc <> ''O''.'.
  src '    cv_msg = ''Password source must be S or O.''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF p_move <> ''MOVE''.'.
  src '    cv_msg = ''Server must support UID MOVE; COPY mode is disab'.
  cnt 'led.''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  CONCATENATE ''abcdefghijklmnopqrstuvwxyz'''.
  src '              ''ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._/-'''.
  src '              INTO lv_chars.'.
  src '  lv_mlen = STRLEN( p_mbox ).'.
  src '  lv_dlen = STRLEN( p_done ).'.
  src '  IF lv_mlen = 0 OR lv_dlen = 0.'.
  src '    cv_msg = ''Enter inbox and processed folder names.''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF p_mbox(lv_mlen) CN lv_chars OR'.
  src '     p_done(lv_dlen) CN lv_chars OR'.
  src '     p_mbox(lv_mlen) CA space OR p_done(lv_dlen) CA space.'.
  src '    cv_msg = ''Folder names: letters, digits and . _ / - (no sp'.
  cnt 'aces).''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '* Reject case-only differences too: some servers alias those na'.
  cnt 'mes.'.
  src '  lv_source = p_mbox.'.
  src '  lv_target = p_done.'.
  src '  TRANSLATE lv_source USING'.
  src '    ''aAbBcCdDeEfFgGhHiIjJkKlLmMnNoOpPqQrRsStTuUvVwWxXyYzZ''.'.
  src '  TRANSLATE lv_target USING'.
  src '    ''aAbBcCdDeEfFgGhHiIjJkKlLmMnNoOpPqQrRsStTuUvVwWxXyYzZ''.'.
  src '  IF lv_source = lv_target.'.
  src '    cv_msg = ''Read and processed folders must be different.''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF p_hprog IS INITIAL.'.
  src '    p_hprog = ''ZCHE_IMAP_HANDLER_DEMO''.'.
  src '  ENDIF.'.
  src '  IF p_hform IS INITIAL.'.
  src '    p_hform = ''HANDLE_MAIL''.'.
  src '  ENDIF.'.
  src '* cv_ok stays empty until the profile is really saved.'.
  src '  PERFORM handler_allowed USING p_hprog p_hform CHANGING lv_all'.
  cnt 'owed.'.
  src '  IF lv_allowed IS INITIAL.'.
  src '    cv_msg = ''Handler rejected by server-owned prefix policy'''.
  cnt '.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  SELECT SINGLE name FROM trdir INTO lv_name WHERE name = p_hpr'.
  cnt 'og.'.
  src '  IF sy-subrc <> 0.'.
  src '    CONCATENATE ''Handler program not found:'' p_hprog'.
  src '                INTO cv_msg SEPARATED BY space.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src ''.
  src '  SELECT SINGLE * FROM zche_imap_prof INTO ls_old'.
  src '    WHERE profile = p_prof.'.
  src '  IF sy-subrc <> 0.'.
  src '    lv_new = ''X''.'.
  src '    CLEAR ls_old.'.
  src '  ENDIF.'.
  src '  IF p_crsrc = ''S'' AND p_pwd IS INITIAL AND ls_old-pwdat IS I'.
  cnt 'NITIAL.'.
  src '    cv_msg = ''Enter the password (password source S).''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  SELECT SINGLE profile FROM zche_imap_log INTO lv_logged'.
  src '    WHERE profile = p_prof.'.
  src '  IF sy-subrc = 0.'.
  src '    IF ls_old-host <> p_host OR ls_old-port <> p_port OR'.
  src '       ls_old-security <> p_sec OR ls_old-username <> p_user OR'.
  src '       ls_old-mailbox <> p_mbox OR ls_old-donebox <> p_done OR'.
  src '       ls_old-movemode <> p_move.'.
  src '      cv_msg = ''Mail identity in use: create a new profile.''.'.
  src '      EXIT.'.
  src '    ENDIF.'.
  src '  ENDIF.'.
  src '  lv_revision = ls_old-revision.'.
  src '  IF lv_revision >= ''9999999999''.'.
  src '    cv_msg = ''Profile revision exhausted; create a new profile'.
  cnt '.''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF p_crsrc = ''S'' AND p_pwd IS INITIAL AND'.
  src '     ls_old-credrev IS INITIAL.'.
  src '    cv_msg = ''Migration: reenter password for namespace storag'.
  cnt 'e.''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src ''.
  src '  ls_prof = ls_old.'.
  src '  ADD 1 TO lv_revision.'.
  src '  ls_prof-revision = lv_revision.'.
  src '  ls_prof-profile  = p_prof.'.
  src '  ls_prof-descr    = p_descr.'.
  src '  ls_prof-active   = p_act.'.
  src '  ls_prof-host     = p_host.'.
  src '  ls_prof-port     = p_port.'.
  src '  ls_prof-security = p_sec.'.
  src '  ls_prof-verify   = p_ver.'.
  src '  ls_prof-username = p_user.'.
  src '  ls_prof-credsrc  = p_crsrc.'.
  src '  ls_prof-mailbox  = p_mbox.'.
  src '  ls_prof-donebox  = p_done.'.
  src '  ls_prof-movemode = p_move.'.
  src '  ls_prof-hprog    = p_hprog.'.
  src '  ls_prof-hform    = p_hform.'.
  src '  ls_prof-maxmail  = p_maxm.'.
  src '  ls_prof-maxmb    = p_maxmb.'.
  src '  ls_prof-timeout  = p_tout.'.
  src '  ls_prof-retdays  = p_ret.'.
  src '  IF NOT lv_new IS INITIAL.'.
  src '    ls_prof-crdat = sy-datum.'.
  src '    ls_prof-crusr = sy-uname.'.
  src '  ENDIF.'.
  src '  ls_prof-chdat = sy-datum.'.
  src '  ls_prof-chtim = sy-uzeit.'.
  src '  ls_prof-chusr = sy-uname.'.
  src ''.
  src '  IF p_crsrc = ''S'' AND NOT p_pwd IS INITIAL.'.
  src '    ls_prof-credrev = ls_prof-revision.'.
  src '    PERFORM write_cred USING ls_prof CHANGING cv_ok cv_msg.'.
  src '    IF cv_ok IS INITIAL.'.
  src '      EXIT.'.
  src '    ENDIF.'.
  src '    ls_prof-pwdat = sy-datum.'.
  src '    ls_prof-pwusr = sy-uname.'.
  src '  ENDIF.'.
  src ''.
  src '  PERFORM write_conf USING ls_prof CHANGING cv_ok cv_msg.'.
  src '  IF cv_ok IS INITIAL.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src ''.
  src '  MODIFY zche_imap_prof FROM ls_prof.'.
  src '  IF sy-subrc <> 0.'.
  src '    ROLLBACK WORK.'.
  src '    CLEAR cv_ok.'.
  src '    cv_msg = ''Profile publish failed; prior revision is active'.
  cnt '.''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  COMMIT WORK AND WAIT.'.
  src '  IF sy-subrc <> 0.'.
  src '    CLEAR cv_ok.'.
  src '    cv_msg = ''Profile commit failed; check active revision.''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF ls_old-credsrc = ''S'' AND ls_old-credrev IS NOT INITIAL'.
  src '     AND ( ls_prof-credsrc <> ''S'' OR'.
  src '           ls_old-credrev <> ls_prof-credrev ).'.
  src '    PERFORM delete_old_credential USING ls_old CHANGING cv_msg.'.
  src '    IF cv_msg IS NOT INITIAL.'.
  src '      CLEAR p_pwd.'.
  src '      cv_ok = ''X''.'.
  src '      EXIT.'.
  src '    ENDIF.'.
  src '  ENDIF.'.
  src '  CLEAR p_pwd.'.
  src '  cv_ok = ''X''.'.
  src '  CONCATENATE ''Profile saved:'' p_prof INTO cv_msg'.
  src '              SEPARATED BY space.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM write_conf USING    is_prof TYPE zche_imap_prof'.
  src '                CHANGING cv_ok   TYPE c'.
  src '                         cv_msg  TYPE c.'.
  src '  DATA: lt_lines     TYPE ty_t_line,'.
  src '        ls_line      TYPE zche_imap_s_line,'.
  src '        lv_path(255) TYPE c,'.
  src '        lv_num(10)   TYPE c,'.
  src '        lv_dsmsg(100) TYPE c,'.
  src '        lv_key(28) TYPE c.'.
  src ''.
  src '  DEFINE add_line.'.
  src '    CONCATENATE &1 &2 INTO ls_line-text.'.
  src '    APPEND ls_line TO lt_lines.'.
  src '  END-OF-DEFINITION.'.
  src ''.
  src '  ls_line-text = ''# Written by ZCHE_IMAP_CONFIG; do not edit b'.
  cnt 'y hand''.'.
  src '  APPEND ls_line TO lt_lines.'.
  src '  PERFORM storage_key USING is_prof-profile CHANGING lv_key.'.
  src '  add_line ''PROFILE='' lv_key.'.
  src '  add_line ''REVISION='' is_prof-revision.'.
  src '  add_line ''CREDSRC='' is_prof-credsrc.'.
  src '  add_line ''CREDREV='' is_prof-credrev.'.
  src '  add_line ''HOST='' is_prof-host.'.
  src '  lv_num = is_prof-port.'.
  src '  SHIFT lv_num LEFT DELETING LEADING ''0''.'.
  src '  add_line ''PORT='' lv_num.'.
  src '  add_line ''SECURITY='' is_prof-security.'.
  src '  add_line ''VERIFY='' is_prof-verify.'.
  src '  add_line ''USER='' is_prof-username.'.
  src '  add_line ''MAILBOX='' is_prof-mailbox.'.
  src '  add_line ''DONEBOX='' is_prof-donebox.'.
  src '  add_line ''MOVEMODE='' is_prof-movemode.'.
  src '  lv_num = is_prof-maxmb.'.
  src '  SHIFT lv_num LEFT DELETING LEADING ''0''.'.
  src '  add_line ''MAXMB='' lv_num.'.
  src '  lv_num = is_prof-timeout.'.
  src '  SHIFT lv_num LEFT DELETING LEADING ''0''.'.
  src '  add_line ''TIMEOUT='' lv_num.'.
  src '  lv_num = is_prof-retdays.'.
  src '  SHIFT lv_num LEFT DELETING LEADING ''0''.'.
  src '  add_line ''RETENTION='' lv_num.'.
  src '  add_line ''CODEPAGE='' gv_filecp.'.
  src ''.
  src '  CONCATENATE gv_root ''conf'' gv_sep lv_key ''_'''.
  src '              is_prof-revision ''.conf'''.
  src '              INTO lv_path.'.
  src '  PERFORM write_text_file USING lv_path lt_lines'.
  src '                          CHANGING cv_ok lv_dsmsg.'.
  src '  IF cv_ok IS INITIAL.'.
  src '    CONCATENATE ''Cannot write config file (S_DATASET?):'' lv_d'.
  cnt 'smsg'.
  src '                INTO cv_msg SEPARATED BY space.'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src '* Password file. The password is never written to the table;'.
  src '* this file is not read back from SAP.'.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM write_cred USING is_prof TYPE zche_imap_prof'.
  src '                CHANGING cv_ok  TYPE c'.
  src '                         cv_msg TYPE c.'.
  src '  DATA: lt_lines      TYPE ty_t_line,'.
  src '        ls_line       TYPE zche_imap_s_line,'.
  src '        lv_path(255)  TYPE c,'.
  src '        lv_dsmsg(100) TYPE c,'.
  src '        lv_key(28) TYPE c.'.
  src ''.
  src '  CONCATENATE ''PASSWORD='' p_pwd INTO ls_line-text.'.
  src '  APPEND ls_line TO lt_lines.'.
  src '  PERFORM storage_key USING is_prof-profile CHANGING lv_key.'.
  src '  CONCATENATE gv_root ''secret'' gv_sep lv_key ''_'''.
  src '              is_prof-credrev ''.cred'' INTO lv_path.'.
  src '  PERFORM write_text_file USING lv_path lt_lines'.
  src '                          CHANGING cv_ok lv_dsmsg.'.
  src '  CLEAR: lt_lines, ls_line.'.
  src '  IF cv_ok IS INITIAL.'.
  src '    CONCATENATE ''Cannot write password file (S_DATASET?):'' lv'.
  cnt '_dsmsg'.
  src '                INTO cv_msg SEPARATED BY space.'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM delete_profile.'.
  src '  DATA lv_ok(1) TYPE c.'.
  src ''.
  src '  PERFORM profile_auth USING p_prof ''02'' CHANGING lv_ok.'.
  src '  IF lv_ok IS INITIAL.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  PERFORM table_auth USING ''ZCHE_IMAP_PROF'' ''U'' CHANGING lv'.
  cnt '_ok.'.
  src '  IF lv_ok IS INITIAL.'.
  src '    PERFORM show_msg USING ''E'' ''No profile change authorizat'.
  cnt 'ion''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  PERFORM profile_valid USING p_prof CHANGING lv_ok.'.
  src '  IF lv_ok IS INITIAL.'.
  src '    PERFORM show_msg USING ''E'' ''Invalid profile name''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF gv_setup IS INITIAL.'.
  src '    PERFORM show_msg USING ''E'' ''Setup missing or wrong host'.
  cnt '''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  PERFORM profile_lock USING p_prof CHANGING lv_ok.'.
  src '  IF lv_ok IS INITIAL.'.
  src '    PERFORM show_msg USING ''S'' ''Profile in use; try again''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  PERFORM delete_profile_locked.'.
  src '  PERFORM profile_unlock USING p_prof.'.
  src 'ENDFORM.'.
  src ''.
  src 'FORM delete_profile_locked.'.
  src '  DATA: lv_answer(1)  TYPE c,'.
  src '        lv_ok(1)      TYPE c,'.
  src '        lv_q(200)     TYPE c,'.
  src '        lv_path(255)  TYPE c,'.
  src '        lv_key(28) TYPE c,'.
  src '        lv_logged LIKE zche_imap_log-profile,'.
  src '        ls_prof TYPE zche_imap_prof.'.
  src ''.
  src '  SELECT SINGLE profile FROM zche_imap_log INTO lv_logged'.
  src '    WHERE profile = p_prof.'.
  src '  IF sy-subrc = 0.'.
  src '    PERFORM show_msg USING ''S'''.
  src '      ''Profile has mail history: deactivate; use a new name.'''.
  cnt '.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  SELECT SINGLE * FROM zche_imap_prof INTO ls_prof'.
  src '    WHERE profile = p_prof.'.
  src '  IF sy-subrc <> 0.'.
  src '    PERFORM show_msg USING ''S'' ''Profile not found''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF p_prof IS INITIAL.'.
  src '    PERFORM show_msg USING ''E'' ''Enter the profile name.''.'.
  src '  ENDIF.'.
  src '  CONCATENATE ''Delete profile'' p_prof'.
  src '    ''and current files? Older revisions need admin cleanup.'''.
  src '    INTO lv_q SEPARATED BY space.'.
  src '  PERFORM fm_exists USING ''POPUP_TO_CONFIRM'' CHANGING lv_ok.'.
  src '  IF NOT lv_ok IS INITIAL.'.
  src '    CALL FUNCTION ''POPUP_TO_CONFIRM'''.
  src '      EXPORTING'.
  src '        titlebar              = ''Delete profile'''.
  src '        text_question         = lv_q'.
  src '        text_button_1         = ''Delete'''.
  src '        text_button_2         = ''Cancel'''.
  src '        display_cancel_button = '' '''.
  src '      IMPORTING'.
  src '        answer                = lv_answer'.
  src '      EXCEPTIONS'.
  src '        OTHERS                = 1.'.
  src '  ELSE.'.
  src '    CALL FUNCTION ''POPUP_TO_CONFIRM_STEP'''.
  src '      EXPORTING'.
  src '        textline1 = lv_q(70)'.
  src '        titel     = ''Delete profile'''.
  src '      IMPORTING'.
  src '        answer    = lv_answer'.
  src '      EXCEPTIONS'.
  src '        OTHERS    = 1.'.
  src '    IF lv_answer = ''J''.'.
  src '      lv_answer = ''1''.'.
  src '    ENDIF.'.
  src '  ENDIF.'.
  src '  IF lv_answer <> ''1''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src ''.
  src '  DELETE FROM zche_imap_prof WHERE profile = p_prof.'.
  src '  IF sy-subrc <> 0.'.
  src '    ROLLBACK WORK.'.
  src '    PERFORM show_msg USING ''S'' ''Profile delete failed''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  COMMIT WORK.'.
  src '  PERFORM storage_key USING p_prof CHANGING lv_key.'.
  src '  IF NOT gv_setup IS INITIAL.'.
  src '    CONCATENATE gv_root ''conf'' gv_sep lv_key ''_'''.
  src '                ls_prof-revision ''.conf'' INTO lv_path.'.
  src '    PERFORM delete_file USING lv_path.'.
  src '    IF ls_prof-credsrc = ''S''.'.
  src '      CONCATENATE gv_root ''secret'' gv_sep lv_key ''_'''.
  src '                  ls_prof-credrev ''.cred'' INTO lv_path.'.
  src '    ELSE.'.
  src '      CONCATENATE gv_root ''secret'' gv_sep lv_key ''.cred'''.
  src '                  INTO lv_path.'.
  src '    ENDIF.'.
  src '    PERFORM delete_file USING lv_path.'.
  src '  ENDIF.'.
  src '  PERFORM show_msg USING ''S'''.
  src '    ''Profile deleted; review old conf/secret revisions with ad'.
  cnt 'min.''.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src '* F8: save and test the connection (list output)'.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM save_and_test.'.
  src '  DATA: lt_out      TYPE ty_t_line,'.
  src '        ls_out      TYPE zche_imap_s_line,'.
  src '        lv_ok(1)    TYPE c,'.
  src '        lv_msg(255) TYPE c,'.
  src '        lv_ver(20)  TYPE c,'.
