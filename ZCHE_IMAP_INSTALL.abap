* Project: abap-imap-inbound
*---------------------------------------------------------------
* ZCHE_IMAP_INSTALL - abap-imap-inbound installer (v0.9.2)
*
* Usage: in SE38 create an executable program named ZCHE_IMAP_INSTALL
* (local object, $TMP), paste this whole file, activate it and
* run it with F8.
*
* Creates ($TMP):
*   ZCHE_IMAP_* domains and data elements (only our own DDIC)
*   ZCHE_IMAP_PARAM, ZCHE_IMAP_PROF, ZCHE_IMAP_LOG          tables
*   ZCHE_IMAP_S_MAIL, ZCHE_IMAP_S_ATT, ZCHE_IMAP_S_LINE        structures
*   ZCHE_IMAP_COMMON, ZCHE_IMAP_IO                         includes
*   ZCHE_IMAP_INBOUND, ZCHE_IMAP_CONFIG, ZCHE_IMAP_MONITOR     programs
*   ZCHE_IMAP_HANDLER_DEMO                             sample handler
*   ZCHE_IMAP_LIST / FETCH / DONE / TEST               SM69 commands
*
* Running it again is safe: existing objects are not touched,
* only missing fields are added to tables. To update the programs
* tick "Overwrite". Removal requires manual review in SE11/SE38.
*
* ABAP 7.00: installer DDIC parameters that differ by release are
* checked at runtime; if a function is missing, the step is
* skipped and the manual work is written to the screen.
*
* This file is generated by installer/build.ps1; do not edit it.
*---------------------------------------------------------------
REPORT zche_imap_install LINE-SIZE 150.

TYPES: BEGIN OF ty_defl,
         line(72) TYPE c,
       END OF ty_defl.
TYPES: BEGIN OF ty_dom,
         name(30)  TYPE c,
         dtype(4)  TYPE c,
         len       TYPE i,
         outlen    TYPE i,
         lower(1)  TYPE c,
         text(60)  TYPE c,
       END OF ty_dom.
TYPES: BEGIN OF ty_val,
         dom(30)   TYPE c,
         value(10) TYPE c,
         text(60)  TYPE c,
       END OF ty_val.
TYPES: BEGIN OF ty_dtel,
         name(30)  TYPE c,
         dom(30)   TYPE c,
         short(10) TYPE c,
         mid(20)   TYPE c,
         long(40)  TYPE c,
       END OF ty_dtel.
TYPES: BEGIN OF ty_tab,
         name(30)  TYPE c,
         class(8)  TYPE c,
         text(60)  TYPE c,
       END OF ty_tab.
TYPES: BEGIN OF ty_fld,
         tab(30)   TYPE c,
         field(30) TYPE c,
         key(1)    TYPE c,
         dtel(30)  TYPE c,
       END OF ty_fld.
TYPES: BEGIN OF ty_txt,
         prog(40)  TYPE c,
         id(1)     TYPE c,
         key(8)    TYPE c,
         text(60)  TYPE c,
       END OF ty_txt.
TYPES: BEGIN OF ty_change,
         prog(40) TYPE c,
         existed(1) TYPE c,
       END OF ty_change.
TYPES: BEGIN OF ty_backup,
         prog(40) TYPE c,
         source TYPE abapsource,
       END OF ty_backup.
TYPES: BEGIN OF ty_textbak,
         prog(40) TYPE c,
         text TYPE textpool,
       END OF ty_textbak.
TYPES: BEGIN OF ty_cmdbak,
         command TYPE sxpgcolist,
         existed(1) TYPE c,
       END OF ty_cmdbak.

DATA: gt_src    TYPE STANDARD TABLE OF abapsource,
      gs_src    TYPE abapsource,
      gt_def    TYPE STANDARD TABLE OF ty_defl,
      gs_def    TYPE ty_defl,
      gt_dom    TYPE STANDARD TABLE OF ty_dom,
      gt_val    TYPE STANDARD TABLE OF ty_val,
      gt_dtel   TYPE STANDARD TABLE OF ty_dtel,
      gt_tab    TYPE STANDARD TABLE OF ty_tab,
      gt_fld    TYPE STANDARD TABLE OF ty_fld,
      gt_txt    TYPE STANDARD TABLE OF ty_txt,
      gt_change TYPE STANDARD TABLE OF ty_change,
      gt_backup TYPE STANDARD TABLE OF ty_backup,
      gt_textbak TYPE STANDARD TABLE OF ty_textbak,
      gt_cmdbak TYPE STANDARD TABLE OF ty_cmdbak,
      gv_uni(1) TYPE c,
      gv_err(1) TYPE c,
      gv_initerr(1) TYPE c,
      gv_cmdwrite(1) TYPE c,
      gv_lock(1) TYPE c,
      gv_setup_lock(1) TYPE c,
      gv_newinb(1) TYPE c,
      gv_same   TYPE i.

CONSTANTS gc_version(10) TYPE c VALUE '0.9.2'.

* Embedded source lines: src adds a new line, cnt continues the
* last line (for lines longer than 72 characters). def adds a
* DDIC or text definition.
DEFINE src.
  gs_src-line = &1.
  APPEND gs_src TO gt_src.
END-OF-DEFINITION.

DEFINE cnt.
  PERFORM continue_line USING &1.
END-OF-DEFINITION.

DEFINE def.
  gs_def-line = &1.
  APPEND gs_def TO gt_def.
END-OF-DEFINITION.

