FORM fill_monitor.
  src '* Project: abap-imap-inbound'.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src '* ZCHE_IMAP_MONITOR - processed and failed mails'.
  src '*'.
  src '* List: by profile, status and date. Double-click a line to see'.
  src '* the headers, body and attachments of the mail.'.
  src '*   Attachment or "Original mail" line: the file is downloaded'.
  cnt ' to'.
  src '*   your PC. PDF, images and text can open in a viewer; all oth'.
  cnt 'er'.
  src '*   types, including original mail, are downloaded only.'.
  src '*   "Reprocess": a failed mail is processed in the next run.'.
  src '*'.
  src '* Classic ABAP 7.00 syntax target.'.
  src '* Uses the new SAP GUI classes if they exist, otherwise the WS_'.
  cnt '*'.
  src '* functions.'.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'REPORT zche_imap_monitor LINE-SIZE 200 NO STANDARD PAGE HEADING'.
  cnt '.'.
  src ''.
  src 'TABLES zche_imap_log.'.
  src ''.
  src 'INCLUDE zche_imap_common.'.
