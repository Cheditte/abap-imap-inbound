  src '  ls_input = ls_mail.'.
  src '  SET UPDATE TASK LOCAL.'.
  src '  IF sy-subrc <> 0.'.
  src '    ROLLBACK WORK.'.
  src '    lv_msg = ''Local update could not be activated; handler ski'.
  cnt 'pped''.'.
  src '    PERFORM set_status USING ls_mail ''E'' lv_msg'.
  src '                       CHANGING lv_status lv_logmsg.'.
  src '    gv_fail = gv_fail + 1.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  PERFORM (lv_form) IN PROGRAM (lv_prog)'.
  src '          USING ls_input lt_body lt_att'.
  src '          CHANGING lv_ok lv_msg IF FOUND.'.
  src '  IF lv_ok <> ''X''.'.
  src '    ROLLBACK WORK.'.
  src '    FORMAT COLOR COL_NEGATIVE INTENSIFIED OFF.'.
  src '    WRITE: / ''  Business logic error:'', lv_msg(120).'.
  src '    FORMAT COLOR OFF.'.
  src '    PERFORM set_status USING ls_mail ''E'' lv_msg'.
  src '                       CHANGING lv_status lv_logmsg.'.
  src '    gv_fail = gv_fail + 1.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src ''.
  src '* COMMIT here: business logic changes and status H together'.
  src '  PERFORM set_status USING ls_mail ''H'' space'.
  src '                     CHANGING lv_status lv_logmsg.'.
  src '  IF lv_status IS INITIAL.'.
  src '    gv_fail = gv_fail + 1.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  PERFORM finish_mail USING is_prof iv_uidv iv_uid.'.
