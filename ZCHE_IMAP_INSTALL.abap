  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF NOT iv_field IS INITIAL.'.
  src '    CALL FUNCTION ''F4IF_INT_TABLE_VALUE_REQUEST'''.
  src '      EXPORTING'.
  src '        retfield        = ''PROFILE'''.
  src '        dynpprog        = sy-repid'.
  src '        dynpnr          = sy-dynnr'.
  src '        dynprofield     = ''P_PROF'''.
  src '        value_org       = ''S'''.
  src '      TABLES'.
  src '        value_tab       = lt_f4'.
  src '      EXCEPTIONS'.
  src '        OTHERS          = 1.'.
  src '  ELSE.'.
  src '    CALL FUNCTION ''F4IF_INT_TABLE_VALUE_REQUEST'''.
  src '      EXPORTING'.
  src '        retfield        = ''PROFILE'''.
  src '        value_org       = ''S'''.
  src '      TABLES'.
  src '        value_tab       = lt_f4'.
  src '        return_tab      = lt_ret'.
  src '      EXCEPTIONS'.
  src '        OTHERS          = 1.'.
  src '    READ TABLE lt_ret INTO ls_ret INDEX 1.'.
  src '    IF sy-subrc = 0.'.
  src '      p_prof = ls_ret-fieldval.'.
  src '    ENDIF.'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM load_profile.'.
  src '  DATA: ls_prof TYPE zche_imap_prof,'.
  src '        lv_auth(1) TYPE c.'.
  src ''.
  src '  PERFORM profile_auth USING p_prof ''03'' CHANGING lv_auth.'.
  src '  IF lv_auth IS INITIAL.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  PERFORM table_auth USING ''ZCHE_IMAP_PROF'' ''S'''.
  src '                     CHANGING lv_auth.'.
  src '  IF lv_auth IS INITIAL.'.
  src '    PERFORM show_msg USING ''E'' ''No profile display authoriza'.
  cnt 'tion''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF p_prof IS INITIAL.'.
  src '    PERFORM show_msg USING ''E'' ''Enter the profile name.''.'.
  src '  ENDIF.'.
  src '  SELECT SINGLE * FROM zche_imap_prof INTO ls_prof'.
