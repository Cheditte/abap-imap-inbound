  src ''.
  src 'START-OF-SELECTION.'.
  src '  PERFORM table_auth USING ''ZCHE_IMAP_LOG'' ''S'' CHANGING gv_'.
  cnt 'auth.'.
  src '  IF gv_auth IS INITIAL.'.
  src '    WRITE: / ''No log display authorization (S_TABU_DIS).''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
