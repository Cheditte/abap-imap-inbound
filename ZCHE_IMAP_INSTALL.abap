FORM fill_config.
  src '* Project: abap-imap-inbound'.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src '* ZCHE_IMAP_CONFIG - IMAP mailbox profiles'.
  src '*'.
  src '* Buttons: Load profile, Save, Delete, Profiles.'.
  src '* F8: saves and tests the connection step by step.'.
  src '*'.
  src '* Password entry is masked; ordinary variant saving is disabled'.
  cnt '.'.
  src '* The profile table keeps only entry date/user and the immutabl'.
  cnt 'e'.
  src '* credential revision. The password is written to the namespace'.
  cnt 'd'.
  src '* secret file and is not read back by this application.'.
  src '* With source O, Basis maintains the secret on the server.'.
  src '*'.
  src '* Classic ABAP 7.00 syntax target.'.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'REPORT zche_imap_config LINE-SIZE 150 NO STANDARD PAGE HEADING.'.
  src ''.
  src 'TABLES: zche_imap_prof, sscrfields.'.
  src ''.
  src 'INCLUDE zche_imap_common.'.
  src ''.
  src 'TYPES: BEGIN OF ty_f4,'.
  src '         profile LIKE zche_imap_prof-profile,'.
  src '         descr   LIKE zche_imap_prof-descr,'.
  src '         host    LIKE zche_imap_prof-host,'.
  src '       END OF ty_f4.'.
  src ''.
  src 'DATA: gv_setup(1) TYPE c,'.
  src '      gv_pwdguard(1) TYPE c.'.
  src ''.
  src 'SELECTION-SCREEN FUNCTION KEY 1.'.
  src 'SELECTION-SCREEN FUNCTION KEY 2.'.
  src 'SELECTION-SCREEN FUNCTION KEY 3.'.
  src 'SELECTION-SCREEN FUNCTION KEY 4.'.
  src ''.
  src 'SELECTION-SCREEN BEGIN OF BLOCK b0 WITH FRAME TITLE t_b0.'.
  src 'PARAMETERS: p_prof  LIKE zche_imap_prof-profile,'.
  src '            p_descr LIKE zche_imap_prof-descr LOWER CASE,'.
  src '            p_act   AS CHECKBOX DEFAULT ''X''.'.
  src 'SELECTION-SCREEN END OF BLOCK b0.'.
  src ''.
  src 'SELECTION-SCREEN BEGIN OF BLOCK b1 WITH FRAME TITLE t_b1.'.
  src 'PARAMETERS: p_host LIKE zche_imap_prof-host LOWER CASE,'.
  src '            p_port LIKE zche_imap_prof-port DEFAULT ''993'','.
  src '            p_sec  LIKE zche_imap_prof-security DEFAULT ''IMAPS'.
  cnt ''''.
  src '                   VALUE CHECK,'.
  src '            p_ver  AS CHECKBOX DEFAULT ''X''.'.
  src 'SELECTION-SCREEN END OF BLOCK b1.'.
  src ''.
  src 'SELECTION-SCREEN BEGIN OF BLOCK b2 WITH FRAME TITLE t_b2.'.
  src 'PARAMETERS: p_user  LIKE zche_imap_prof-username LOWER CASE,'.
  src '            p_crsrc LIKE zche_imap_prof-credsrc DEFAULT ''O'''.
  src '                    VALUE CHECK,'.
  src '            p_pwd(100) TYPE c LOWER CASE.'.
  src 'SELECTION-SCREEN COMMENT /1(79) c_pwst.'.
  src 'SELECTION-SCREEN END OF BLOCK b2.'.
  src ''.
  src 'SELECTION-SCREEN BEGIN OF BLOCK b3 WITH FRAME TITLE t_b3.'.
  src 'PARAMETERS: p_mbox LIKE zche_imap_prof-mailbox LOWER CASE'.
  src '                   DEFAULT ''INBOX'','.
  src '            p_done LIKE zche_imap_prof-donebox LOWER CASE'.
  src '                   DEFAULT ''SAP-Processed'','.
  src '            p_move LIKE zche_imap_prof-movemode DEFAULT ''MOVE'.
  cnt ''''.
  src '                   VALUE CHECK.'.
  src 'SELECTION-SCREEN END OF BLOCK b3.'.
  src ''.
  src 'SELECTION-SCREEN BEGIN OF BLOCK b4 WITH FRAME TITLE t_b4.'.
  src 'PARAMETERS: p_hprog LIKE zche_imap_prof-hprog'.
  src '                    DEFAULT ''ZCHE_IMAP_HANDLER_DEMO'','.
  src '            p_hform LIKE zche_imap_prof-hform DEFAULT ''HANDLE_'.
  cnt 'MAIL'','.
  src '            p_maxm  LIKE zche_imap_prof-maxmail DEFAULT ''50'','.
  src '            p_maxmb LIKE zche_imap_prof-maxmb DEFAULT ''20'','.
  src '            p_tout  LIKE zche_imap_prof-timeout DEFAULT ''120'''.
  cnt ','.
  src '            p_ret   LIKE zche_imap_prof-retdays DEFAULT ''30''.'.
  src 'SELECTION-SCREEN END OF BLOCK b4.'.
  src ''.
  src 'INITIALIZATION.'.
  src '  sscrfields-functxt_01 = ''Load profile''.'.
  src '  sscrfields-functxt_02 = ''Save''.'.
  src '  sscrfields-functxt_03 = ''Delete''.'.
  src '  sscrfields-functxt_04 = ''Profiles''.'.
  src '  t_b0 = ''Profile''.'.
  src '  t_b1 = ''Mail server''.'.
  src '  t_b2 = ''Credentials''.'.
  src '  t_b3 = ''IMAP folders''.'.
  src '  t_b4 = ''Processing''.'.
  src '  PERFORM get_setup CHANGING gv_setup.'.
  src ''.
  src 'AT SELECTION-SCREEN OUTPUT.'.
  src '  PERFORM protect_password_ui CHANGING gv_pwdguard.'.
  src '  IF gv_pwdguard IS INITIAL.'.
  src '    CLEAR p_pwd.'.
  src '  ENDIF.'.
  src '  LOOP AT SCREEN.'.
  src '    IF screen-name = ''P_PWD''.'.
  src '      screen-invisible = ''1''.'.
  src '      IF p_crsrc = ''O'' OR gv_pwdguard IS INITIAL.'.
  src '        screen-input = ''0''.'.
  src '      ENDIF.'.
  src '      MODIFY SCREEN.'.
  src '    ENDIF.'.
  src '  ENDLOOP.'.
  src '  PERFORM pw_status.'.
  src ''.
  src 'AT SELECTION-SCREEN ON VALUE-REQUEST FOR p_prof.'.
  src '  PERFORM f4_profile USING ''X''.'.
  src ''.
  src 'AT SELECTION-SCREEN.'.
  src '  CASE sscrfields-ucomm.'.
  src '    WHEN ''SPOS'' OR ''PRIN''.'.
  src '      CLEAR p_pwd.'.
  src '      PERFORM show_msg USING ''E'''.
  src '        ''Variant saving/printing is disabled on this screen.'''.
  cnt '.'.
  src '    WHEN ''FC01''.'.
  src '      PERFORM load_profile.'.
  src '    WHEN ''FC02''.'.
  src '      PERFORM save_on_screen.'.
  src '    WHEN ''FC03''.'.
  src '      PERFORM delete_profile.'.
  src '    WHEN ''FC04''.'.
  src '      PERFORM f4_profile USING '' ''.'.
  src '      PERFORM load_profile.'.
  src '  ENDCASE.'.
  src ''.
  src 'START-OF-SELECTION.'.
  src '  PERFORM save_and_test.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src '* Block ordinary selection-screen variant saving and printing.'.
  src '* No claim is made about privileged external variant APIs.'.
  src 'FORM protect_password_ui CHANGING cv_ok TYPE c.'.
  src '  DATA: lv_exists(1) TYPE c,'.
  src '        lv_param(30) TYPE c,'.
  src '        lt_exclude TYPE STANDARD TABLE OF sy-ucomm,'.
  src '        lv_code LIKE sy-ucomm.'.
  src ''.
  src '  CLEAR cv_ok.'.
  src '  lv_code = ''SPOS''.'.
  src '  APPEND lv_code TO lt_exclude.'.
  src '  lv_code = ''PRIN''.'.
  src '  APPEND lv_code TO lt_exclude.'.
  src '  CALL FUNCTION ''RS_SET_SELSCREEN_STATUS'''.
  src '    EXPORTING'.
  src '      p_status = sy-pfkey'.
  src '    TABLES'.
  src '      p_exclude = lt_exclude'.
  src '    EXCEPTIONS'.
  src '      OTHERS = 1.'.
  src '  IF sy-subrc = 0.'.
  src '    cv_ok = ''X''.'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM pw_status.'.
  src '  DATA: ls_prof    TYPE zche_imap_prof,'.
  src '        lv_date(10) TYPE c,'.
  src '        lv_auth(1) TYPE c.'.
  src ''.
  src '  CLEAR c_pwst.'.
  src '  PERFORM profile_auth USING p_prof ''03'' CHANGING lv_auth.'.
  src '  IF lv_auth IS INITIAL.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  PERFORM table_auth USING ''ZCHE_IMAP_PROF'' ''S'''.
  src '                     CHANGING lv_auth.'.
  src '  IF lv_auth IS INITIAL.'.
  src '    c_pwst = ''No profile display authorization (S_TABU_DIS).'''.
  cnt '.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF p_crsrc = ''O''.'.
  src '    c_pwst = ''Basis keeps the password on the server (setup-se'.
  cnt 'rver).''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF gv_pwdguard IS INITIAL.'.
  src '    c_pwst = ''New password entry unavailable; use Basis source'.
  cnt ' O.''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  SELECT SINGLE * FROM zche_imap_prof INTO ls_prof'.
  src '    WHERE profile = p_prof.'.
  src '  IF sy-subrc = 0 AND NOT ls_prof-pwdat IS INITIAL.'.
  src '    WRITE ls_prof-pwdat TO lv_date DD/MM/YYYY.'.
  src '    CONCATENATE ''Password saved:'' lv_date ls_prof-pwusr'.
  src '                ''(type a new password to change it)'''.
  src '                INTO c_pwst SEPARATED BY space.'.
  src '  ELSE.'.
  src '    c_pwst = ''No password entered yet.''.'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src '* iv_field = ''X'': writes directly to field P_PROF on the scre'.
  cnt 'en'.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM f4_profile USING iv_field TYPE c.'.
  src '  DATA: lt_f4  TYPE STANDARD TABLE OF ty_f4,'.
  src '        ls_f4  TYPE ty_f4,'.
  src '        lt_ret TYPE STANDARD TABLE OF ddshretval,'.
  src '        ls_ret TYPE ddshretval,'.
  src '        lv_auth(1) TYPE c.'.
  src ''.
  src '  PERFORM table_auth USING ''ZCHE_IMAP_PROF'' ''S'''.
  src '                     CHANGING lv_auth.'.
  src '  IF lv_auth IS INITIAL.'.
  src '    PERFORM show_msg USING ''E'' ''No profile display authoriza'.
  cnt 'tion''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  SELECT profile descr host FROM zche_imap_prof INTO TABLE lt_f'.
  cnt '4.'.
  src '* Offer only profiles the user may display (ZCHE_IMAP 03).'.
  src '  LOOP AT lt_f4 INTO ls_f4.'.
  src '    PERFORM profile_auth USING ls_f4-profile ''03'''.
  src '                         CHANGING lv_auth.'.
  src '    IF lv_auth IS INITIAL.'.
