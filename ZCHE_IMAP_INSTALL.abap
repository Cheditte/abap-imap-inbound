  src '  ENDIF.'.
  src '  gv_root = lv_val.'.
  src '  IF gv_root CA ''/''.'.
  src '    gv_sep = ''/''.'.
  src '  ELSE.'.
  src '    gv_sep = ''\''.'.
  src '  ENDIF.'.
  src '  lv_len = STRLEN( gv_root ) - 1.'.
  src '  IF gv_root+lv_len(1) <> gv_sep.'.
  src '    CONCATENATE gv_root gv_sep INTO gv_root.'.
  src '  ENDIF.'.
  src '  SELECT SINGLE pvalue FROM zche_imap_param INTO lv_val'.
  src '    WHERE param = ''FILECP''.'.
  src '  IF sy-subrc <> 0 OR lv_val IS INITIAL.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  gv_filecp = lv_val.'.
  src '  cv_ok = ''X''.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src '* Folder of the mail on the server. Processed (S):'.
  src '* Both locations use SID_client_profile/UIDVALIDITY-UID.'.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM mail_dir USING    iv_status TYPE c'.
  src '                       iv_prof   TYPE c'.
  src '                       iv_uidv   TYPE c'.
  src '                       iv_uid    TYPE n'.
  src '              CHANGING cv_dir    TYPE c.'.
  src '  DATA: lv_uidc(10) TYPE c,'.
  src '        lv_uidv(20) TYPE c,'.
  src '        lv_key(28) TYPE c.'.
  src ''.
  src '  lv_uidc = iv_uid.'.
  src '  SHIFT lv_uidc LEFT DELETING LEADING ''0''.'.
  src '  lv_uidv = iv_uidv.'.
  src '  CONDENSE lv_uidv NO-GAPS.'.
  src '  PERFORM storage_key USING iv_prof CHANGING lv_key.'.
  src '  IF iv_status = ''S''.'.
  src '    CONCATENATE gv_root ''done'' gv_sep lv_key gv_sep'.
  src '                lv_uidv ''-'' lv_uidc gv_sep INTO cv_dir.'.
  src '  ELSE.'.
  src '    CONCATENATE gv_root ''in'' gv_sep lv_key gv_sep'.
  src '                lv_uidv ''-'' lv_uidc gv_sep INTO cv_dir.'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM storage_key USING iv_prof TYPE c CHANGING cv_key TYPE c.'.
  src '  CONCATENATE sy-sysid sy-mandt iv_prof INTO cv_key'.
  src '              SEPARATED BY ''_''.'.
  src 'ENDFORM.'.
  src ''.
  src 'FORM profile_valid USING iv_prof TYPE c CHANGING cv_ok TYPE c.'.
  src '  DATA lv_len TYPE i.'.
  src ''.
  src '  CLEAR cv_ok.'.
  src '  lv_len = STRLEN( iv_prof ).'.
  src '  IF lv_len < 1 OR lv_len > 20.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF iv_prof(lv_len) CN ''ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_'.
  cnt '''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  cv_ok = ''X''.'.
  src 'ENDFORM.'.
  src ''.
  src '* Scope 1 locks one SID/client/profile across commits.'.
  src '* E_TABLE is intentional: no generated lock FM is required.'.
  src 'FORM profile_lock USING iv_prof TYPE c CHANGING cv_ok TYPE c.'.
  src '  DATA: lv_key(28) TYPE c,'.
  src '        lv_varkey LIKE rstable-varkey.'.
  src ''.
  src '  CLEAR cv_ok.'.
  src '  PERFORM storage_key USING iv_prof CHANGING lv_key.'.
  src '  lv_varkey = lv_key.'.
  src '  CALL FUNCTION ''ENQUEUE_E_TABLE'''.
  src '    EXPORTING'.
  src '      tabname = ''ZCHE_IMAP_PROF'''.
  src '      varkey  = lv_varkey'.
  src '      _scope  = ''1'''.
  src '    EXCEPTIONS'.
  src '      OTHERS  = 1.'.
  src '  IF sy-subrc = 0.'.
  src '    cv_ok = ''X''.'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src 'FORM profile_unlock USING iv_prof TYPE c.'.
  src '  DATA: lv_key(28) TYPE c,'.
  src '        lv_varkey LIKE rstable-varkey.'.
  src ''.
  src '  PERFORM storage_key USING iv_prof CHANGING lv_key.'.
  src '  lv_varkey = lv_key.'.
  src '  CALL FUNCTION ''DEQUEUE_E_TABLE'''.
  src '    EXPORTING'.
  src '      tabname = ''ZCHE_IMAP_PROF'''.
  src '      varkey  = lv_varkey'.
  src '      _scope  = ''1''.'.
  src 'ENDFORM.'.
  src ''.
  src '* Generic table checks are not implicit in application Open SQL'.
  cnt '.'.
  src '* Fail closed if an old release lacks the checked API contract.'.
  src 'FORM table_auth USING iv_table TYPE c iv_action TYPE c'.
  src '                CHANGING cv_ok TYPE c.'.
  src '  DATA: lv_exists(1) TYPE c,'.
  src '        lv_param(30) TYPE c,'.
  src '        lv_table LIKE dd25v-viewname,'.
  src '        lv_action(1) TYPE c.'.
  src ''.
  src '  CLEAR cv_ok.'.
  src '  lv_table = iv_table.'.
  src '  lv_action = iv_action.'.
  src '  CALL FUNCTION ''VIEW_AUTHORITY_CHECK'''.
  src '    EXPORTING'.
  src '      view_action = lv_action'.
  src '      view_name   = lv_table'.
  src '    EXCEPTIONS'.
  src '      OTHERS      = 1.'.
  src '  IF sy-subrc = 0.'.
  src '    cv_ok = ''X''.'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM fm_exists USING iv_func TYPE c CHANGING cv_ok TYPE c.'.
  src '  CLEAR cv_ok.'.
  src '  CALL FUNCTION ''FUNCTION_EXISTS'''.
  src '    EXPORTING funcname = iv_func'.
  src '    EXCEPTIONS function_not_exist = 1 OTHERS = 2.'.
  src '  IF sy-subrc = 0.'.
  src '    cv_ok = ''X''.'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM class_exists USING    iv_class TYPE c'.
  src '                  CHANGING cv_ok    TYPE c.'.
  src '  DATA lv_class(30) TYPE c.'.
  src ''.
  src '  CLEAR cv_ok.'.
  src '  SELECT SINGLE clsname FROM seoclass INTO lv_class'.
  src '    WHERE clsname = iv_class.'.
  src '  IF sy-subrc = 0.'.
  src '    cv_ok = ''X''.'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src '* Runs an SM69 command. The last line of the script is the resu'.
  cnt 'lt'.
  src '* line: "OK" or "ERR <CODE> <description>". Other lines go to'.
  src '* ct_out. On error cv_msg has the form "ERR ..." (map_error).'.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM call_cmd USING    iv_cmd   TYPE c'.
  src '                       iv_param TYPE c'.
  src '              CHANGING ct_out   TYPE ty_t_line'.
  src '                       cv_ok    TYPE c'.
  src '                       cv_msg   TYPE c.'.
  src '  DATA: lt_prot      TYPE STANDARD TABLE OF btcxpm,'.
  src '        ls_prot      TYPE btcxpm,'.
  src '        ls_out       TYPE zche_imap_s_line,'.
  src '        lv_cmd       LIKE sxpgcolist-name,'.
  src '        lv_par       LIKE sxpgcolist-parameters,'.
  src '        lv_rc(4)     TYPE c,'.
  src '        lv_idx       TYPE i,'.
  src '        lv_last      TYPE i,'.
  src '        lv_err       TYPE i,'.
  src '        lv_text(128) TYPE c,'.
  src '        lv_protocol TYPE i.'.
  src ''.
  src '  CLEAR: ct_out, cv_ok, cv_msg.'.
  src '  lv_cmd = iv_cmd.'.
  src '  lv_par = iv_param.'.
  src '  IF lv_par <> iv_param OR lv_cmd <> iv_cmd.'.
  src '    cv_msg = ''ERR ARG SM69 parameters exceed the target field'.
  cnt '''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src ''.
  src '* Only parameters that exist in every release are used. A'.
  src '* parameter missing from the interface stops the program at'.
  src '* runtime.'.
  src '  CALL FUNCTION ''SXPG_COMMAND_EXECUTE'''.
  src '    EXPORTING'.
  src '      commandname                = lv_cmd'.
  src '      additional_parameters      = lv_par'.
  src '    TABLES'.
  src '      exec_protocol              = lt_prot'.
  src '    EXCEPTIONS'.
  src '      no_permission              = 1'.
  src '      command_not_found          = 2'.
  src '      parameters_too_long        = 3'.
  src '      security_risk              = 4'.
  src '      wrong_check_call_interface = 5'.
  src '      program_start_error        = 6'.
  src '      program_termination_error  = 7'.
  src '      x_error                    = 8'.
  src '      parameter_expected         = 9'.
  src '      too_many_parameters        = 10'.
  src '      illegal_command            = 11'.
  src '      OTHERS                     = 12.'.
  src '  IF sy-subrc <> 0.'.
  src '    lv_rc = sy-subrc.'.
  src '    CONDENSE lv_rc.'.
  src '    CONCATENATE ''ERR SXPG'' lv_rc INTO cv_msg.'.
  src '    CONCATENATE cv_msg iv_cmd INTO cv_msg SEPARATED BY space.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src ''.
  src '* When the script ends with an error, SAP adds its own line'.
  src '* ("... terminated with exit code 1") after the script''s ERR l'.
  cnt 'ine.'.
  src '* The script''s ERR line is the one that says what went wrong.'.
  src '  LOOP AT lt_prot INTO ls_prot.'.
  src '    IF NOT ls_prot-message IS INITIAL.'.
  src '      lv_last = sy-tabix.'.
  src '      lv_text = ls_prot-message.'.
  src '      SHIFT lv_text LEFT DELETING LEADING space.'.
  src '      IF lv_text(4) = ''ERR ''.'.
  src '        lv_err = sy-tabix.'.
  src '      ENDIF.'.
  src '      IF lv_text = ''PROTOCOL 2''.'.
  src '        lv_protocol = lv_protocol + 1.'.
  src '      ENDIF.'.
  src '    ENDIF.'.
  src '  ENDLOOP.'.
  src ''.
  src '  LOOP AT lt_prot INTO ls_prot.'.
  src '    lv_idx = sy-tabix.'.
  src '    lv_text = ls_prot-message.'.
  src '    SHIFT lv_text LEFT DELETING LEADING space.'.
  src '    IF lv_text = ''PROTOCOL 2''.'.
  src '      CONTINUE.'.
  src '    ENDIF.'.
  src '    IF lv_err > 0.'.
  src '      IF lv_idx = lv_err.'.
  src '        cv_msg = lv_text.'.
  src '      ELSEIF lv_idx < lv_err.'.
  src '        ls_out-text = lv_text.'.
  src '        APPEND ls_out TO ct_out.'.
  src '      ENDIF.'.
  src '    ELSEIF lv_idx = lv_last.'.
  src '      IF lv_text(3) = ''OK ''.'.
  src '        cv_ok = ''X''.'.
  src '      ELSE.'.
  src '        cv_msg = lv_text.'.
  src '      ENDIF.'.
  src '    ELSE.'.
  src '      ls_out-text = lv_text.'.
  src '      APPEND ls_out TO ct_out.'.
  src '    ENDIF.'.
  src '  ENDLOOP.'.
  src ''.
  src '  IF lv_last = 0.'.
  src '    CONCATENATE ''ERR EXC Command gave no output:'' iv_cmd'.
  src '      INTO cv_msg SEPARATED BY space.'.
  src '  ENDIF.'.
  src '  IF NOT cv_ok IS INITIAL AND lv_protocol <> 1.'.
  src '    CLEAR cv_ok.'.
  src '    cv_msg = ''ERR CFG Script protocol mismatch; install v0.9.2'.
  cnt '''.'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src '* Turns an error line ("ERR CODE description") into a readable'.
  src '* text and a next step. cv_detail is the technical description.'.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM map_error USING    iv_line   TYPE c'.
  src '               CHANGING cv_text   TYPE c'.
  src '                        cv_hint   TYPE c'.
  src '                        cv_detail TYPE c.'.
  src '  DATA: lv_err(10)  TYPE c,'.
  src '        lv_code(20) TYPE c.'.
  src ''.
  src '  CLEAR: cv_text, cv_hint, cv_detail.'.
  src '  SPLIT iv_line AT space INTO lv_err lv_code cv_detail.'.
  src '  IF lv_err <> ''ERR''.'.
  src '    cv_text = iv_line.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  CASE lv_code.'.
  src '    WHEN ''AUTH''.'.
  src '      cv_text = ''Wrong user name or password.''.'.
  src '      cv_hint = ''ZCHE_IMAP_CONFIG: enter the password again.'''.
  cnt '.'.
  src '    WHEN ''CONNECT''.'.
  src '      cv_text = ''Cannot reach the mail server.''.'.
  src '      cv_hint = ''Check server name and port; firewall (Basis).'.
  cnt '''.'.
  src '    WHEN ''TLS''.'.
  src '      cv_text = ''Server certificate could not be verified.''.'.
  src '      cv_hint = ''Install the company CA cert on the server (Ba'.
  cnt 'sis).''.'.
  src '    WHEN ''POLICY''.'.
  src '      cv_text = ''The Basis policy does not allow this setting.'.
  cnt '''.'.
  src '      cv_hint = ''Basis: bin/policy.psd1 (allowed servers).''.'.
  src '    WHEN ''CFG''.'.
  src '      cv_text = ''Profile settings are missing or invalid.''.'.
  src '      cv_hint = ''Save the profile with ZCHE_IMAP_CONFIG.''.'.
  src '    WHEN ''MAILBOX''.'.
  src '      cv_text = ''IMAP folder not found.''.'.
  src '      cv_hint = ''Check the inbox and processed folder names.'''.
  cnt '.'.
  src '    WHEN ''NOMAIL''.'.
  src '      cv_text = ''Mail not found on the server (may be deleted)'.
  cnt '.''.'.
  src '    WHEN ''SIZE''.'.
  src '      cv_text = ''Mail exceeds the size limit.''.'.
  src '      cv_hint = ''ZCHE_IMAP_CONFIG: increase the max mail size'.
  cnt ' (MB).''.'.
  src '    WHEN ''PARSE''.'.
  src '      cv_text = ''Mail content is invalid or exceeds parser lim'.
  cnt 'its.''.'.
  src '      cv_hint = ''Review MIME/HTML detail; ask for a corrected'.
  cnt ' mail.''.'.
  src '    WHEN ''ARG''.'.
  src '      cv_text = ''Invalid parameter passed to the script.''.'.
  src '    WHEN ''SXPG1''.'.
  src '      cv_text = ''No authorization for the OS command.''.'.
  src '      cv_hint = ''Authorization object S_LOG_COM (ZCHE_IMAP_*).'.
  cnt '''.'.
  src '    WHEN ''SXPG2''.'.
  src '      cv_text = ''SM69 command is not defined.''.'.
  src '      cv_hint = ''Run the program ZCHE_IMAP_INSTALL.''.'.
  src '    WHEN OTHERS.'.
  src '      IF lv_code(4) = ''SXPG''.'.
  src '        cv_text = ''SM69 command could not be run.''.'.
  src '        cv_hint = ''Test the command in SM49; script folder (Ba'.
  cnt 'sis).''.'.
  src '      ELSE.'.
  src '        cv_text = ''Unexpected error.''.'.
  src '      ENDIF.'.
  src '  ENDCASE.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM write_error USING iv_line TYPE c.'.
  src '  DATA: lv_text(120)   TYPE c,'.
  src '        lv_hint(120)   TYPE c,'.
  src '        lv_detail(255) TYPE c.'.
  src ''.
  src '  PERFORM map_error USING iv_line'.
  src '                    CHANGING lv_text lv_hint lv_detail.'.
  src '  FORMAT COLOR COL_NEGATIVE INTENSIFIED OFF.'.
  src '  WRITE: / ''  Error :'', lv_text.'.
  src '  FORMAT COLOR OFF.'.
  src '  IF NOT lv_hint IS INITIAL.'.
  src '    WRITE: / ''  Action:'', lv_hint.'.
  src '  ENDIF.'.
  src '  IF NOT lv_detail IS INITIAL.'.
  src '    WRITE: / ''  Detail:'', lv_detail(120).'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src '* Reads the parsed mail folder (header, body, attach).'.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM read_mail_dir USING    iv_dir  TYPE c'.
  src '                   CHANGING cs_mail TYPE zche_imap_s_mail'.
  src '                            ct_body TYPE ty_t_line'.
  src '                            ct_att  TYPE ty_t_att'.
  src '                            cv_ok   TYPE c'.
  src '                            cv_msg  TYPE c.'.
  src '  DATA: lt_lines     TYPE ty_t_line,'.
  src '        ls_line      TYPE zche_imap_s_line,'.
  src '        ls_att       TYPE zche_imap_s_att,'.
  src '        lv_path(255) TYPE c,'.
  src '        lv_key(20)   TYPE c,'.
  src '        lv_val(255)  TYPE c.'.
  src ''.
  src '  CLEAR: ct_body, ct_att, cv_ok, cv_msg.'.
  src '  cs_mail-dir = iv_dir.'.
  src ''.
  src '* ready.flg is written last; if missing, parsing did not finish'.
  src '  CONCATENATE iv_dir ''ready.flg'' INTO lv_path.'.
  src '  PERFORM read_text_file USING lv_path CHANGING lt_lines cv_ok.'.
  src '  IF cv_ok IS INITIAL.'.
  src '    cv_msg = ''Mail files not found on the server''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src ''.
  src '  CONCATENATE iv_dir ''header.txt'' INTO lv_path.'.
  src '  PERFORM read_text_file USING lv_path CHANGING lt_lines cv_ok.'.
  src '  IF cv_ok IS INITIAL.'.
  src '    cv_msg = ''Could not read header.txt''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  LOOP AT lt_lines INTO ls_line.'.
  src '    PERFORM apply_header_line USING ls_line-text CHANGING cs_ma'.
  cnt 'il.'.
  src '  ENDLOOP.'.
  src ''.
  src '  CONCATENATE iv_dir ''body.txt'' INTO lv_path.'.
  src '  PERFORM read_text_file USING lv_path CHANGING ct_body cv_ok.'.
  src '  IF cv_ok IS INITIAL.'.
  src '    cv_msg = ''Could not read body.txt''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src ''.
  src '  CONCATENATE iv_dir ''attach.txt'' INTO lv_path.'.
  src '  PERFORM read_text_file USING lv_path CHANGING lt_lines cv_ok.'.
  src '  IF cv_ok IS INITIAL.'.
  src '    cv_msg = ''Could not read attach.txt''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  LOOP AT lt_lines INTO ls_line.'.
  src '    CLEAR ls_att.'.
  src '    SPLIT ls_line-text AT ''|'' INTO ls_att-name ls_att-attsize'.
  src '          ls_att-mime ls_att-disp ls_att-orig.'.
  src '    CONCATENATE iv_dir ''att'' gv_sep ls_att-name INTO ls_att-p'.
  cnt 'ath.'.
  src '    APPEND ls_att TO ct_att.'.
  src '  ENDLOOP.'.
  src 'ENDFORM.'.
  src ''.
  src 'FORM apply_header_line USING iv_line TYPE c'.
  src '                       CHANGING cs_mail TYPE zche_imap_s_mail.'.
  src '  DATA: lv_key(20) TYPE c, lv_val(255) TYPE c.'.
  src '    CLEAR: lv_key, lv_val.'.
  src '*   The last field takes the rest of the text, ''='' signs incl'.
  cnt 'uded'.
  src '    SPLIT iv_line AT ''='' INTO lv_key lv_val.'.
  src '    CASE lv_key.'.
  src '      WHEN ''FROM''.      cs_mail-sender    = lv_val.'.
  src '      WHEN ''TO''.        cs_mail-recipient = lv_val.'.
  src '      WHEN ''CC''.        cs_mail-copy_to   = lv_val.'.
  src '      WHEN ''SUBJECT''.   cs_mail-subject   = lv_val.'.
  src '      WHEN ''DATE''.      cs_mail-maildate  = lv_val.'.
  src '      WHEN ''MESSAGEID''. cs_mail-messageid = lv_val.'.
  src '      WHEN ''ATTCOUNT''.  cs_mail-attcnt    = lv_val.'.
  src '    ENDCASE.'.
  src 'ENDFORM.'.
  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src '* Splits a long text into chunks of 50 for the screen message'.
  src '* (message 00/001: &1&2&3&4).'.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM show_msg USING iv_type TYPE c'.
  src '                    iv_text TYPE c.'.
  src '  DATA lv_text(200) TYPE c.'.
  src ''.
  src '  lv_text = iv_text.'.
  src '  MESSAGE ID ''00'' TYPE iv_type NUMBER ''001'''.
  src '          WITH lv_text(50) lv_text+50(50) lv_text+100(50)'.
  src '               lv_text+150(50).'.
  src 'ENDFORM.'.
  src ''.
  src '* Both the configuration UI and processor enforce this server-o'.
  cnt 'wned prefix.'.
  src 'FORM handler_allowed USING iv_prog TYPE c iv_form TYPE c'.
  src '                     CHANGING cv_ok TYPE c.'.
  src '  DATA: lv_prefix(255) TYPE c, lv_pattern(256) TYPE c,'.
  src '        lv_length TYPE i.'.
  src '  CLEAR cv_ok.'.
  src '  SELECT SINGLE pvalue FROM zche_imap_param INTO lv_prefix'.
  src '    WHERE param = ''HANDLER_PREFIX''.'.
  src '  IF sy-subrc <> 0 OR lv_prefix IS INITIAL.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  lv_length = STRLEN( lv_prefix ).'.
  src '  IF lv_prefix(1) <> ''Z'' AND lv_prefix(1) <> ''Y''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  IF lv_prefix(lv_length) CN ''ABCDEFGHIJKLMNOPQRSTUVWXYZ012345'.
  cnt '6789_''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  CONCATENATE lv_prefix ''*'' INTO lv_pattern.'.
  src '  IF iv_prog NP lv_pattern OR iv_form IS INITIAL.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  lv_length = STRLEN( iv_form ).'.
  src '  IF iv_form(lv_length) CN ''ABCDEFGHIJKLMNOPQRSTUVWXYZ01234567'.
  cnt '89_''.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  cv_ok = ''X''.'.
  src 'ENDFORM.'.
  src ''.
  src 'FORM profile_auth USING iv_prof TYPE c iv_activity TYPE c'.
  src '                  CHANGING cv_ok TYPE c.'.
  src '  CLEAR cv_ok.'.
  src '  AUTHORITY-CHECK OBJECT ''ZCHE_IMAP'''.
  src '    ID ''ZCHE_PROF'' FIELD iv_prof'.
  src '    ID ''ACTVT'' FIELD iv_activity.'.
  src '  IF sy-subrc = 0.'.
  src '    cv_ok = ''X''.'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src 'FORM list_arguments USING iv_key TYPE c iv_revision TYPE c'.
  src '                          iv_test TYPE c CHANGING cv_args TYPE'.
  cnt ' c.'.
  src '  CONCATENATE iv_key iv_revision INTO cv_args SEPARATED BY spac'.
  cnt 'e.'.
  src '  IF iv_test IS INITIAL.'.
  src '    CONCATENATE cv_args ''PURGE'' INTO cv_args SEPARATED BY spa'.
  cnt 'ce.'.
  src '  ENDIF.'.
  src 'ENDFORM.'.
  src ''.
  src 'INCLUDE zche_imap_io.'.
  src ''.
  src 'CLASS ltc_protocol DEFINITION FOR TESTING. "#AU Risk_Level Harm'.
  cnt 'less'.
  src '  PRIVATE SECTION.'.
  src '    METHODS long_profile_purge FOR TESTING.'.
