  src '    gv_fail = gv_fail + 1.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src ''.
  src '  PERFORM mail_dir USING '' '' is_prof-profile iv_uidv iv_uid'.
  src '                   CHANGING lv_dir.'.
  src '  PERFORM read_mail_dir USING lv_dir'.
  src '                        CHANGING ls_mail lt_body lt_att lv_ok l'.
  cnt 'v_msg.'.
  src '  IF lv_ok IS INITIAL.'.
  src '    WRITE: / ''  UID'', lv_uidc, ''could not be read:'', lv_msg'.
  cnt '(100).'.
  src '    PERFORM set_status USING ls_mail ''E'' lv_msg'.
  src '                       CHANGING lv_status lv_logmsg.'.
  src '    gv_fail = gv_fail + 1.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src ''.
  src '  lv_prog = is_prof-hprog.'.
  src '  lv_form = is_prof-hform.'.
  src '  IF lv_prog IS INITIAL.'.
  src '    lv_prog = ''ZCHE_IMAP_HANDLER_DEMO''.'.
  src '  ENDIF.'.
  src '  IF lv_form IS INITIAL.'.
  src '    lv_form = ''HANDLE_MAIL''.'.
  src '  ENDIF.'.
  src '  PERFORM handler_allowed USING lv_prog lv_form CHANGING lv_ok.'.
  src '  IF lv_ok IS INITIAL.'.
  src '    lv_msg = ''Handler rejected by server-owned prefix policy'''.
  cnt '.'.
  src '    PERFORM set_status USING ls_mail ''E'' lv_msg'.
  src '                       CHANGING lv_status lv_logmsg.'.
  src '    gv_fail = gv_fail + 1.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '* If the handler is not found, lv_ok stays empty and this'.
  src '* message is logged'.
  src '  CLEAR lv_ok.'.
  src '  CONCATENATE ''Handler not found:'' lv_prog lv_form'.
  src '              INTO lv_msg SEPARATED BY space.'.
  src '  WRITE: / ''  UID'', lv_uidc, ls_mail-subject(80).'.
  src '* Local V1 updates and H are one database LUW. A failed update'.
  src '* aborts this LUW, including H; no remote mail move has run yet'.
  cnt '.'.
  src '* Handler code must not commit, roll back, call RFC or submit'.
