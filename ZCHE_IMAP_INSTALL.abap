  src ''.
  src '*--------------------------------------------------------------'.
  cnt '-'.
  src 'FORM finish_mail USING is_prof TYPE zche_imap_prof'.
  src '                       iv_uidv TYPE c'.
  src '                       iv_uid  TYPE n.'.
  src '  DATA: lt_out      TYPE ty_t_line,'.
  src '        ls_mail     TYPE zche_imap_s_mail,'.
  src '        lv_uidc(10) TYPE c,'.
  src '        lv_uidv(20) TYPE c,'.
  src '        lv_par(128) TYPE c,'.
  src '        lv_ok(1)    TYPE c,'.
  src '        lv_msg(255) TYPE c,'.
  src '        lv_key(28) TYPE c,'.
  src '        lv_status(1) TYPE c,'.
  src '        lv_logmsg(255) TYPE c.'.
  src ''.
  src '  lv_uidc = iv_uid.'.
  src '  SHIFT lv_uidc LEFT DELETING LEADING ''0''.'.
  src '  lv_uidv = iv_uidv.'.
  src '  CONDENSE lv_uidv NO-GAPS.'.
  src '  PERFORM storage_key USING is_prof-profile CHANGING lv_key.'.
  src '  CONCATENATE lv_key lv_uidc lv_uidv is_prof-revision INTO lv_p'.
  cnt 'ar'.
  src '              SEPARATED BY space.'.
  src '  PERFORM call_cmd USING ''ZCHE_IMAP_DONE'' lv_par'.
  src '                   CHANGING lt_out lv_ok lv_msg.'.
  src '  IF lv_ok IS INITIAL.'.
  src '*   Status stays H; the next run only retries the move'.
  src '    WRITE: / ''  UID'', lv_uidc, ''processed but could not be m'.
  cnt 'oved.''.'.
  src '    PERFORM write_error USING lv_msg.'.
  src '    gv_fail = gv_fail + 1.'.
  src '    EXIT.'.
  src '  ENDIF.'.
  src '  ls_mail-profile     = is_prof-profile.'.
