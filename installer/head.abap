FORM next_steps.
  SKIP.
  WRITE: / 'Next steps:',
         / '  1. ZCHE_IMAP_CONFIG: mailbox profile, password, F8 test',
         / '  2. ZCHE_IMAP_INBOUND: first with "List only", then SM36',
         / '  3. ZCHE_IMAP_MONITOR: processed mails, attachments, errors'.
  SKIP.
  WRITE: / 'Required authorizations (PFCG):',
         / '  Job user        : S_LOG_COM ZCHE_IMAP_LIST/FETCH/DONE;',
           'S_DATASET ZCHE_IMAP_INBOUND read',
         / '  Administrator   : S_LOG_COM ZCHE_IMAP_TEST; S_DATASET',
           'ZCHE_IMAP_CONFIG write (conf, secret)',
         / '  Monitoring      : S_DATASET ZCHE_IMAP_MONITOR read',
         / '  Tables          : S_TABU_DIS group ZCHI',
         / '  Optional        : define object ZCHE_IMAP in SU21 for',
           'per-profile access (see SECURITY.md)'.
ENDFORM.

*---------------------------------------------------------------
FORM continue_line USING iv_text TYPE c.
  DATA lv_idx TYPE i.

  DESCRIBE TABLE gt_src LINES lv_idx.
  READ TABLE gt_src INTO gs_src INDEX lv_idx.
  CONCATENATE gs_src-line iv_text INTO gs_src-line.
  MODIFY gt_src FROM gs_src INDEX lv_idx.
ENDFORM.

*---------------------------------------------------------------
* Unicode detection: CL_ABAP_CHAR_UTILITIES came with 6.10; if it
* is missing the system mode cannot be determined.
*---------------------------------------------------------------
FORM detect_mode.
  FIELD-SYMBOLS <lv_size> TYPE ANY.

  CLEAR gv_uni.
  CASE p_mode.
    WHEN 'U' OR 'u'.
      gv_uni = 'X'.
    WHEN 'L' OR 'l'.
      CLEAR gv_uni.
    WHEN OTHERS.
      ASSIGN ('CL_ABAP_CHAR_UTILITIES=>CHARSIZE') TO <lv_size>.
      IF sy-subrc = 0.
        IF <lv_size> > 1.
          gv_uni = 'X'.
        ENDIF.
      ENDIF.
  ENDCASE.
  IF gv_uni IS INITIAL.
    WRITE: / 'System is not Unicode: files use code page',
             p_cp.
  ELSE.
    WRITE: / 'System is Unicode: files are UTF-8.'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
FORM fm_exists USING iv_func TYPE c CHANGING cv_ok TYPE c.
  CLEAR cv_ok.
  CALL FUNCTION 'FUNCTION_EXISTS'
    EXPORTING funcname = iv_func
    EXCEPTIONS function_not_exist = 1 OTHERS = 2.
  IF sy-subrc = 0.
    cv_ok = 'X'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
FORM fm_has_param USING    iv_func  TYPE c
                           iv_param TYPE c
                  CHANGING cv_ok    TYPE c.
  DATA lv_par(30) TYPE c.

  CLEAR cv_ok.
  SELECT SINGLE parameter FROM fupararef INTO lv_par
    WHERE funcname  = iv_func
      AND parameter = iv_param.
  IF sy-subrc = 0.
    cv_ok = 'X'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
* Creates an empty work area with the type of a function
* parameter. The type name is read from FUPARAREF (for differences
* between releases such as DD09L / DD09V); if it is not found,
* iv_default is used.
*---------------------------------------------------------------
FORM new_wa USING    iv_func    TYPE c
                     iv_param   TYPE c
                     iv_default TYPE c
            CHANGING cr_data    TYPE REF TO data.
  DATA lv_type(30) TYPE c.

  SELECT SINGLE structure FROM fupararef INTO lv_type
    WHERE funcname  = iv_func
      AND parameter = iv_param.
  IF lv_type IS INITIAL.
    lv_type = iv_default.
  ENDIF.
  CREATE DATA cr_data TYPE (lv_type).
ENDFORM.

*---------------------------------------------------------------
FORM set_comp USING    iv_comp TYPE c
                       iv_val  TYPE any
              CHANGING cs_data TYPE any.
  FIELD-SYMBOLS <lv_comp> TYPE ANY.

  ASSIGN COMPONENT iv_comp OF STRUCTURE cs_data TO <lv_comp>.
  IF sy-subrc = 0.
    <lv_comp> = iv_val.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
* Splits the DDIC and text definitions (fill_defs) into tables.
*   D|domain|type|length|output len|lower case X/-|text
*   V|domain|value|text             fixed value
*   E|data element|domain|short|medium  (long = medium)
*   L|data element|long text
*   T|table|TRANSP/INTTAB|text
*   F|table|field|key X/-|data element
*   X|program|selection field|text  selection text
*   Y|program|title
*---------------------------------------------------------------
FORM parse_defs.
  DATA: ls_dom  TYPE ty_dom,
        ls_val  TYPE ty_val,
        ls_dtel TYPE ty_dtel,
        ls_tab  TYPE ty_tab,
        ls_fld  TYPE ty_fld,
        ls_txt  TYPE ty_txt,
        lv_k(1)  TYPE c,
        lv_1(40) TYPE c,
        lv_2(60) TYPE c,
        lv_3(60) TYPE c,
        lv_4(60) TYPE c,
        lv_5(60) TYPE c,
        lv_6(60) TYPE c.

  REFRESH: gt_def, gt_dom, gt_val, gt_dtel, gt_tab, gt_fld, gt_txt.
  PERFORM fill_defs.
  LOOP AT gt_def INTO gs_def.
    CLEAR: lv_k, lv_1, lv_2, lv_3, lv_4, lv_5, lv_6.
    SPLIT gs_def-line AT '|' INTO lv_k lv_1 lv_2 lv_3 lv_4 lv_5
                                  lv_6.
    CASE lv_k.
      WHEN 'D'.
        CLEAR ls_dom.
        ls_dom-name   = lv_1.
        ls_dom-dtype  = lv_2.
        ls_dom-len    = lv_3.
        ls_dom-outlen = lv_4.
        IF lv_5 = 'X'.
          ls_dom-lower = 'X'.
        ENDIF.
        ls_dom-text   = lv_6.
        APPEND ls_dom TO gt_dom.
      WHEN 'V'.
        ls_val-dom   = lv_1.
        ls_val-value = lv_2.
        ls_val-text  = lv_3.
        APPEND ls_val TO gt_val.
      WHEN 'E'.
        ls_dtel-name  = lv_1.
        ls_dtel-dom   = lv_2.
        ls_dtel-short = lv_3.
        ls_dtel-mid   = lv_4.
        ls_dtel-long  = lv_4.
        APPEND ls_dtel TO gt_dtel.
      WHEN 'L'.
        READ TABLE gt_dtel INTO ls_dtel WITH KEY name = lv_1.
        IF sy-subrc = 0.
          ls_dtel-long = lv_2.
          MODIFY gt_dtel FROM ls_dtel INDEX sy-tabix.
        ENDIF.
      WHEN 'T'.
        IF lv_2 = 'TRANSP' AND strlen( lv_1 ) > 16.
          WRITE: / 'Database table name exceeds 16 characters:',
                   lv_1.
          gv_initerr = 'X'.
          CONTINUE.
        ENDIF.
        ls_tab-name  = lv_1.
        ls_tab-class = lv_2.
        ls_tab-text  = lv_3.
        APPEND ls_tab TO gt_tab.
      WHEN 'F'.
        CLEAR ls_fld.
        ls_fld-tab   = lv_1.
        ls_fld-field = lv_2.
        IF lv_3 = 'X'.
          ls_fld-key = 'X'.
        ENDIF.
        ls_fld-dtel  = lv_4.
        APPEND ls_fld TO gt_fld.
      WHEN 'X'.
        ls_txt-prog = lv_1.
        ls_txt-id   = 'S'.
        ls_txt-key  = lv_2.
        ls_txt-text = lv_3.
        APPEND ls_txt TO gt_txt.
      WHEN 'Y'.
        CLEAR ls_txt.
        ls_txt-prog = lv_1.
        ls_txt-id   = 'R'.
        ls_txt-text = lv_2.
        APPEND ls_txt TO gt_txt.
    ENDCASE.
  ENDLOOP.
ENDFORM.

*---------------------------------------------------------------
* Object directory entry ($TMP). The language parameter may be
* missing in old releases; the interface is checked first.
*---------------------------------------------------------------
FORM tadir_insert USING iv_object TYPE c
                        iv_name   TYPE c.
  DATA: lv_ok(1)   TYPE c,
        lv_lang(1) TYPE c,
        lv_obj     LIKE tadir-object,
        lv_name    LIKE tadir-obj_name.

  lv_obj  = iv_object.
  lv_name = iv_name.
  PERFORM fm_exists USING 'TR_TADIR_INTERFACE' CHANGING lv_ok.
  IF lv_ok IS INITIAL.
    EXIT.
  ENDIF.
  PERFORM fm_has_param USING 'TR_TADIR_INTERFACE'
                             'WI_TADIR_MASTERLANG'
                       CHANGING lv_lang.
  IF NOT lv_lang IS INITIAL.
    CALL FUNCTION 'TR_TADIR_INTERFACE'
      EXPORTING
        wi_test_modus       = ' '
        wi_tadir_pgmid      = 'R3TR'
        wi_tadir_object     = lv_obj
        wi_tadir_obj_name   = lv_name
        wi_tadir_author     = sy-uname
        wi_tadir_devclass   = '$TMP'
        wi_tadir_masterlang = sy-langu
      EXCEPTIONS
        OTHERS              = 1.
  ELSE.
    CALL FUNCTION 'TR_TADIR_INTERFACE'
      EXPORTING
        wi_test_modus     = ' '
        wi_tadir_pgmid    = 'R3TR'
        wi_tadir_object   = lv_obj
        wi_tadir_obj_name = lv_name
        wi_tadir_author   = sy-uname
        wi_tadir_devclass = '$TMP'
      EXCEPTIONS
        OTHERS            = 1.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
* DDIC order: domain -> data element -> table/structure. Existing
* objects are not touched; the values of domains with fixed
* values and missing table fields are completed.
*---------------------------------------------------------------
FORM create_ddic.
  DATA: ls_dom  TYPE ty_dom,
        ls_dtel TYPE ty_dtel,
        ls_tab  TYPE ty_tab,
        lv_ok(1) TYPE c.

  PERFORM fm_exists USING 'DDIF_TABL_PUT' CHANGING lv_ok.
  IF lv_ok IS INITIAL.
    WRITE: / 'DDIF_TABL_PUT missing: create the DDIC objects',
             'manually in SE11 using the list in the README.'.
    gv_err = 'X'.
    EXIT.
  ENDIF.

  CLEAR gv_same.
  LOOP AT gt_dom INTO ls_dom.
    PERFORM create_domain USING ls_dom.
  ENDLOOP.
  IF NOT gv_err IS INITIAL.
    EXIT.
  ENDIF.
  LOOP AT gt_dtel INTO ls_dtel.
    PERFORM create_dtel USING ls_dtel.
  ENDLOOP.
  IF NOT gv_err IS INITIAL.
    EXIT.
  ENDIF.
  LOOP AT gt_tab INTO ls_tab.
    PERFORM fix_name_conflict USING ls_tab-name.
    IF NOT gv_err IS INITIAL.
      EXIT.
    ENDIF.
    PERFORM create_table USING ls_tab.
  ENDLOOP.
  IF gv_same > 0.
    WRITE: / 'DDIC objects already present:', gv_same.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
FORM create_domain USING is_dom TYPE ty_dom.
  DATA: lr_01        TYPE REF TO data,
        lt_07        TYPE STANDARD TABLE OF dd07v,
        ls_07        TYPE dd07v,
        ls_val       TYPE ty_val,
        lv_name(30)  TYPE c,
        lv_obj(30)   TYPE c,
        lv_pos       TYPE i,
        lv_rc        TYPE i,
        lv_exists(1) TYPE c.
  DATA: lv_dtype LIKE dd01l-datatype,
        lv_length LIKE dd01l-leng,
        lv_lower LIKE dd01l-lowercase,
        lt_old TYPE STANDARD TABLE OF dd07v,
        ls_old TYPE dd07v.
  FIELD-SYMBOLS <ls_01> TYPE ANY.

  LOOP AT gt_val INTO ls_val WHERE dom = is_dom-name.
    lv_pos = lv_pos + 1.
    CLEAR ls_07.
    ls_07-domname    = is_dom-name.
    ls_07-ddlanguage = sy-langu.
    ls_07-valpos     = lv_pos.
    ls_07-domvalue_l = ls_val-value.
    ls_07-ddtext     = ls_val-text.
    APPEND ls_07 TO lt_07.
  ENDLOOP.

  SELECT SINGLE domname FROM dd01l INTO lv_name
    WHERE domname = is_dom-name AND as4local = 'A'.
  IF sy-subrc = 0.
    lv_exists = 'X'.
    SELECT SINGLE datatype leng lowercase FROM dd01l
      INTO (lv_dtype, lv_length, lv_lower)
      WHERE domname = is_dom-name AND as4local = 'A'.
    IF lv_dtype <> is_dom-dtype OR lv_length <> is_dom-len
       OR lv_lower <> is_dom-lower.
      WRITE: / 'Domain schema mismatch; review in SE11:',
               is_dom-name.
      gv_err = 'X'.
      EXIT.
    ENDIF.
*   An existing domain without fixed values is not touched
    IF lt_07[] IS INITIAL.
      gv_same = gv_same + 1.
      EXIT.
    ENDIF.
  ENDIF.

  PERFORM new_wa USING 'DDIF_DOMA_PUT' 'DD01V_WA' 'DD01V'
                 CHANGING lr_01.
  ASSIGN lr_01->* TO <ls_01>.
  IF NOT lv_exists IS INITIAL.
    CALL FUNCTION 'DDIF_DOMA_GET'
      EXPORTING name = is_dom-name state = 'A'
      IMPORTING dd01v_wa = <ls_01>
      TABLES dd07v_tab = lt_old
      EXCEPTIONS OTHERS = 1.
    IF sy-subrc <> 0.
      WRITE: / 'Existing domain could not be read:', is_dom-name.
      gv_err = 'X'.
      EXIT.
    ENDIF.
*   Retire only our unsupported COPY option, also on existing systems.
    IF is_dom-name = 'ZCHE_IMAP_MOVEMODE'.
      DELETE lt_old WHERE domvalue_l = 'COPY'
                      AND domvalue_h = space.
    ENDIF.
*   Preserve other fixed values; append only genuinely new ones.
    LOOP AT lt_old INTO ls_old.
      IF ls_old-valpos > lv_pos.
        lv_pos = ls_old-valpos.
      ENDIF.
    ENDLOOP.
    LOOP AT lt_07 INTO ls_07.
      READ TABLE lt_old WITH KEY domvalue_l = ls_07-domvalue_l
           TRANSPORTING NO FIELDS.
      IF sy-subrc <> 0.
        lv_pos = lv_pos + 1.
        ls_07-valpos = lv_pos.
        APPEND ls_07 TO lt_old.
      ENDIF.
    ENDLOOP.
    lt_07[] = lt_old[].
  ENDIF.
  PERFORM set_comp USING 'DOMNAME' is_dom-name CHANGING <ls_01>.
  PERFORM set_comp USING 'DDLANGUAGE' sy-langu CHANGING <ls_01>.
  PERFORM set_comp USING 'DATATYPE' is_dom-dtype CHANGING <ls_01>.
  PERFORM set_comp USING 'LENG' is_dom-len CHANGING <ls_01>.
  PERFORM set_comp USING 'OUTPUTLEN' is_dom-outlen
                   CHANGING <ls_01>.
  PERFORM set_comp USING 'LOWERCASE' is_dom-lower CHANGING <ls_01>.
  PERFORM set_comp USING 'DDTEXT' is_dom-text CHANGING <ls_01>.
  IF NOT lt_07[] IS INITIAL.
    PERFORM set_comp USING 'VALEXI' 'X' CHANGING <ls_01>.
  ENDIF.

  IF lv_exists IS INITIAL.
    PERFORM tadir_insert USING 'DOMA' is_dom-name.
  ENDIF.
  lv_obj = is_dom-name.
  CALL FUNCTION 'DDIF_DOMA_PUT'
    EXPORTING
      name      = lv_obj
      dd01v_wa  = <ls_01>
    TABLES
      dd07v_tab = lt_07
    EXCEPTIONS
      OTHERS    = 1.
  IF sy-subrc <> 0.
    WRITE: / 'Domain could not be saved:', is_dom-name.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  CALL FUNCTION 'DDIF_DOMA_ACTIVATE'
    EXPORTING
      name   = lv_obj
    IMPORTING
      rc     = lv_rc
    EXCEPTIONS
      OTHERS = 1.
  IF sy-subrc <> 0 OR lv_rc > 4.
    WRITE: / 'Domain could not be activated:', is_dom-name, lv_rc.
    gv_err = 'X'.
  ELSEIF lv_exists IS INITIAL.
    WRITE: / 'Domain created:', is_dom-name.
  ELSE.
    gv_same = gv_same + 1.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
FORM create_dtel USING is_dtel TYPE ty_dtel.
  DATA: lr_04       TYPE REF TO data,
        lv_name(30) TYPE c,
        lv_obj(30)  TYPE c,
        lv_rc       TYPE i.
  DATA lv_domain LIKE dd04l-domname.
  FIELD-SYMBOLS <ls_04> TYPE ANY.

  SELECT SINGLE rollname FROM dd04l INTO lv_name
    WHERE rollname = is_dtel-name AND as4local = 'A'.
  IF sy-subrc = 0.
    SELECT SINGLE domname FROM dd04l INTO lv_domain
      WHERE rollname = is_dtel-name AND as4local = 'A'.
    IF lv_domain <> is_dtel-dom.
      WRITE: / 'Data element mismatch; review in SE11:',
               is_dtel-name.
      gv_err = 'X'.
      EXIT.
    ENDIF.
    gv_same = gv_same + 1.
    EXIT.
  ENDIF.

  PERFORM new_wa USING 'DDIF_DTEL_PUT' 'DD04V_WA' 'DD04V'
                 CHANGING lr_04.
  ASSIGN lr_04->* TO <ls_04>.
  PERFORM set_comp USING 'ROLLNAME' is_dtel-name CHANGING <ls_04>.
  PERFORM set_comp USING 'DDLANGUAGE' sy-langu CHANGING <ls_04>.
  PERFORM set_comp USING 'DOMNAME' is_dtel-dom CHANGING <ls_04>.
  PERFORM set_comp USING 'DDTEXT' is_dtel-long CHANGING <ls_04>.
  PERFORM set_comp USING 'REPTEXT' is_dtel-mid CHANGING <ls_04>.
  PERFORM set_comp USING 'SCRTEXT_S' is_dtel-short
                   CHANGING <ls_04>.
  PERFORM set_comp USING 'SCRTEXT_M' is_dtel-mid CHANGING <ls_04>.
  PERFORM set_comp USING 'SCRTEXT_L' is_dtel-long CHANGING <ls_04>.
  PERFORM set_comp USING 'HEADLEN' 55 CHANGING <ls_04>.
  PERFORM set_comp USING 'SCRLEN1' 10 CHANGING <ls_04>.
  PERFORM set_comp USING 'SCRLEN2' 20 CHANGING <ls_04>.
  PERFORM set_comp USING 'SCRLEN3' 40 CHANGING <ls_04>.

  PERFORM tadir_insert USING 'DTEL' is_dtel-name.
  lv_obj = is_dtel-name.
  CALL FUNCTION 'DDIF_DTEL_PUT'
    EXPORTING
      name     = lv_obj
      dd04v_wa = <ls_04>
    EXCEPTIONS
      OTHERS   = 1.
  IF sy-subrc <> 0.
    WRITE: / 'Data element could not be saved:', is_dtel-name.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  CALL FUNCTION 'DDIF_DTEL_ACTIVATE'
    EXPORTING
      name   = lv_obj
    IMPORTING
      rc     = lv_rc
    EXCEPTIONS
      OTHERS = 1.
  IF sy-subrc <> 0 OR lv_rc > 4.
    WRITE: / 'Data element could not be activated:', is_dtel-name,
             lv_rc.
    gv_err = 'X'.
  ELSE.
    WRITE: / 'Data element created:', is_dtel-name.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
* Tables, structures and data elements share one namespace. If an
* name collision is never proof of ownership. Refuse automatic
* deletion; a developer must review the conflicting DDIC object.
*---------------------------------------------------------------
FORM fix_name_conflict USING iv_name TYPE c.
  DATA: lv_name(30) TYPE c,
        lv_ok(1)    TYPE c.

  SELECT SINGLE tabname FROM dd02l INTO lv_name
    WHERE tabname = iv_name.
  IF sy-subrc = 0.
    EXIT.
  ENDIF.
  SELECT SINGLE rollname FROM dd04l INTO lv_name
    WHERE rollname = iv_name.
  IF sy-subrc <> 0.
    EXIT.
  ENDIF.
  WRITE: / 'Name conflict; review existing data element in SE11:',
           iv_name, '(no objects were deleted)'.
  gv_err = 'X'.
ENDFORM.

*---------------------------------------------------------------
* Table or structure. If it exists, missing fields are added; a
* missing key field cannot be added automatically (it requires
* data conversion).
*---------------------------------------------------------------
FORM create_table USING is_tab TYPE ty_tab.
  DATA: lr_02        TYPE REF TO data,
        lr_09        TYPE REF TO data,
        lt_03        TYPE STANDARD TABLE OF dd03p,
        ls_03        TYPE dd03p,
        ls_fld       TYPE ty_fld,
        lv_name(30)  TYPE c,
        lv_obj(30)   TYPE c,
        lv_pos       TYPE i,
        lv_rc        TYPE i,
        lv_exists(1) TYPE c,
        lv_fail(1)   TYPE c,
         lv_added     TYPE i,
         lv_keypos    TYPE i,
         ls_dtel      TYPE ty_dtel,
         ls_dom       TYPE ty_dom.
  FIELD-SYMBOLS: <ls_02> TYPE ANY,
                 <ls_09> TYPE ANY,
                 <lv_class> TYPE ANY.

  lv_obj = is_tab-name.
  PERFORM new_wa USING 'DDIF_TABL_PUT' 'DD02V_WA' 'DD02V'
                 CHANGING lr_02.
  ASSIGN lr_02->* TO <ls_02>.
  PERFORM new_wa USING 'DDIF_TABL_PUT' 'DD09L_WA' 'DD09L'
                 CHANGING lr_09.
  ASSIGN lr_09->* TO <ls_09>.

  SELECT SINGLE tabname FROM dd02l INTO lv_name
    WHERE tabname = is_tab-name AND as4local = 'A'.
  IF sy-subrc = 0.
    lv_exists = 'X'.
    CALL FUNCTION 'DDIF_TABL_GET'
      EXPORTING
        name      = lv_obj
        state     = 'A'
      IMPORTING
        dd02v_wa  = <ls_02>
        dd09l_wa  = <ls_09>
      TABLES
        dd03p_tab = lt_03
      EXCEPTIONS
        OTHERS    = 1.
    IF sy-subrc <> 0.
      WRITE: / 'Table definition could not be read:', is_tab-name.
      gv_err = 'X'.
      EXIT.
    ENDIF.
    ASSIGN COMPONENT 'TABCLASS' OF STRUCTURE <ls_02> TO <lv_class>.
    IF sy-subrc <> 0.
      gv_err = 'X'.
      EXIT.
    ENDIF.
    IF <lv_class> <> is_tab-class.
      WRITE: / 'Table/structure class mismatch:', is_tab-name.
      gv_err = 'X'.
      EXIT.
    ENDIF.
    LOOP AT lt_03 INTO ls_03 WHERE keyflag = 'X'.
      READ TABLE gt_fld INTO ls_fld
        WITH KEY tab = is_tab-name field = ls_03-fieldname.
      IF sy-subrc <> 0.
        WRITE: / 'Unknown key field; review in SE11:', is_tab-name.
        gv_err = 'X'.
        EXIT.
      ELSEIF ls_fld-key IS INITIAL.
        gv_err = 'X'.
        EXIT.
      ENDIF.
    ENDLOOP.
    IF NOT gv_err IS INITIAL.
      EXIT.
    ENDIF.
    LOOP AT lt_03 INTO ls_03.
      IF ls_03-position > lv_pos.
        lv_pos = ls_03-position.
      ENDIF.
    ENDLOOP.
  ELSE.
    PERFORM set_comp USING 'TABNAME' is_tab-name CHANGING <ls_02>.
    PERFORM set_comp USING 'DDLANGUAGE' sy-langu CHANGING <ls_02>.
    PERFORM set_comp USING 'TABCLASS' is_tab-class
                     CHANGING <ls_02>.
    PERFORM set_comp USING 'DDTEXT' is_tab-text CHANGING <ls_02>.
    PERFORM set_comp USING 'EXCLASS' '1' CHANGING <ls_02>.
    IF is_tab-class = 'TRANSP'.
      PERFORM set_comp USING 'CONTFLAG' 'A' CHANGING <ls_02>.
      PERFORM set_comp USING 'MAINFLAG' space CHANGING <ls_02>.
      PERFORM set_comp USING 'TABNAME' is_tab-name
                       CHANGING <ls_09>.
      PERFORM set_comp USING 'AS4LOCAL' 'A' CHANGING <ls_09>.
      PERFORM set_comp USING 'TABKAT' '0' CHANGING <ls_09>.
      PERFORM set_comp USING 'TABART' 'APPL1' CHANGING <ls_09>.
      PERFORM set_comp USING 'BUFALLOW' 'N' CHANGING <ls_09>.
    ENDIF.
  ENDIF.

  IF is_tab-class = 'TRANSP'.
    PERFORM set_comp USING 'MAINFLAG' space CHANGING <ls_02>.
  ENDIF.

  LOOP AT gt_fld INTO ls_fld WHERE tab = is_tab-name.
    IF NOT ls_fld-key IS INITIAL.
      lv_keypos = lv_keypos + 1.
    ENDIF.
    READ TABLE lt_03 WITH KEY fieldname = ls_fld-field
         INTO ls_03.
    IF sy-subrc = 0.
      IF ls_03-rollname <> ls_fld-dtel
         OR ls_03-keyflag <> ls_fld-key.
        WRITE: / 'Field schema mismatch:', is_tab-name,
                 ls_fld-field, '(manual migration required)'.
        gv_err = 'X'.
        lv_fail = 'X'.
        EXIT.
      ENDIF.
      IF NOT ls_fld-key IS INITIAL AND ls_03-position <> lv_keypos.
        WRITE: / 'Key order mismatch:', is_tab-name, ls_fld-field.
        gv_err = 'X'.
        lv_fail = 'X'.
        EXIT.
      ENDIF.
      READ TABLE gt_dtel INTO ls_dtel WITH KEY name = ls_fld-dtel.
      IF sy-subrc = 0.
        READ TABLE gt_dom INTO ls_dom WITH KEY name = ls_dtel-dom.
        IF sy-subrc = 0.
          IF ls_03-datatype <> ls_dom-dtype
             OR ls_03-leng <> ls_dom-len.
            WRITE: / 'Field type/length mismatch:', is_tab-name,
                     ls_fld-field.
            gv_err = 'X'.
            lv_fail = 'X'.
            EXIT.
          ENDIF.
        ENDIF.
      ENDIF.
      CONTINUE.
    ENDIF.
    IF NOT lv_exists IS INITIAL AND NOT ls_fld-key IS INITIAL.
      WRITE: / is_tab-name, ': key field', ls_fld-field,
               'missing (table from an old version).',
             / '  Review a data-preserving migration in SE11/SE14.'.
      gv_err  = 'X'.
      lv_fail = 'X'.
      EXIT.
    ENDIF.
    lv_pos = lv_pos + 1.
    CLEAR ls_03.
    ls_03-tabname    = is_tab-name.
    ls_03-fieldname  = ls_fld-field.
    ls_03-ddlanguage = sy-langu.
    ls_03-position   = lv_pos.
    ls_03-keyflag    = ls_fld-key.
    ls_03-notnull    = ls_fld-key.
    ls_03-rollname   = ls_fld-dtel.
    APPEND ls_03 TO lt_03.
    lv_added = lv_added + 1.
  ENDLOOP.
* Only this table's error: earlier errors do not block the other
* tables
  IF NOT lv_fail IS INITIAL.
    EXIT.
  ENDIF.
  IF lv_added = 0.
    gv_same = gv_same + 1.
    EXIT.
  ENDIF.

  IF lv_exists IS INITIAL.
    PERFORM tadir_insert USING 'TABL' is_tab-name.
  ENDIF.
  IF is_tab-class = 'TRANSP'.
    CALL FUNCTION 'DDIF_TABL_PUT'
      EXPORTING
        name      = lv_obj
        dd02v_wa  = <ls_02>
        dd09l_wa  = <ls_09>
      TABLES
        dd03p_tab = lt_03
      EXCEPTIONS
        tabl_not_found    = 1
        name_inconsistent = 2
        tabl_inconsistent = 3
        put_failure       = 4
        put_refused       = 5
        OTHERS            = 6.
  ELSE.
    CALL FUNCTION 'DDIF_TABL_PUT'
      EXPORTING
        name      = lv_obj
        dd02v_wa  = <ls_02>
      TABLES
        dd03p_tab = lt_03
      EXCEPTIONS
        tabl_not_found    = 1
        name_inconsistent = 2
        tabl_inconsistent = 3
        put_failure       = 4
        put_refused       = 5
        OTHERS            = 6.
  ENDIF.
  IF sy-subrc <> 0.
    lv_rc = sy-subrc.
    WRITE: / 'Could not be saved:', is_tab-name, 'DDIF_TABL_PUT',
             lv_rc,
           / '  2 name mismatch (other DDIC object with same name?),',
             '3 definition inconsistent, 4/5 save refused'.
    gv_err = 'X'.
    EXIT.
  ENDIF.

  CALL FUNCTION 'DDIF_TABL_ACTIVATE'
    EXPORTING
      name   = lv_obj
    IMPORTING
      rc     = lv_rc
    EXCEPTIONS
      OTHERS = 1.
  IF sy-subrc <> 0 OR lv_rc > 4.
    WRITE: / 'Could not be activated:', is_tab-name,
             '(SE11 activation log) code', lv_rc.
    gv_err = 'X'.
  ELSEIF lv_exists IS INITIAL.
    WRITE: / 'Created:', is_tab-name, is_tab-class.
  ELSE.
    WRITE: / 'Fields added:', is_tab-name, lv_added.
  ENDIF.
  IF gv_err IS INITIAL AND is_tab-class = 'TRANSP'.
    PERFORM assign_table_group USING is_tab-name.
  ENDIF.
ENDFORM.

FORM assign_table_group USING iv_table TYPE c.
  DATA ls_group TYPE tddat.
  ls_group-tabname = iv_table.
  ls_group-cclass = 'ZCHI'.
  MODIFY tddat FROM ls_group.
  IF sy-subrc <> 0.
    gv_err = 'X'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
* ZCHE_IMAP_PARAM: server folder, file code page, version. The table
* is created by this program, so dynamic access is used.
*---------------------------------------------------------------
FORM save_params.
  DATA lv_cp(10) TYPE c.

  IF gv_uni IS INITIAL.
    lv_cp = p_cp.
  ELSE.
    lv_cp = '65001'.
  ENDIF.
  PERFORM save_param USING 'ROOT' p_root.
  PERFORM save_param USING 'FILECP' lv_cp.
  PERFORM save_param USING 'VERSION' gc_version.
  PERFORM save_param USING 'EXEC_HOST' sy-host.
  PERFORM save_param USING 'OWNER' 'ABAP_IMAP_INBOUND'.
* Policy defaults: written once, an administrator's value is kept.
  PERFORM save_param_default USING 'HANDLER_PREFIX'
                                   'ZCHE_IMAP_HANDLER_'.
  PERFORM save_param_default USING 'MAX_ATTEMPTS' '3'.
  IF gv_err IS INITIAL.
    COMMIT WORK.
  ELSE.
    ROLLBACK WORK.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
FORM save_param USING iv_name  TYPE c
                      iv_value TYPE c.
  DATA: lr_wa       TYPE REF TO data,
        lv_tab(30)  TYPE c VALUE 'ZCHE_IMAP_PARAM',
        lv_name(30) TYPE c.
  FIELD-SYMBOLS <ls_wa> TYPE ANY.

  SELECT SINGLE tabname FROM dd02l INTO lv_name
    WHERE tabname = lv_tab AND as4local = 'A'.
  IF sy-subrc <> 0.
    WRITE: / 'Installation settings table is not active.'.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  CREATE DATA lr_wa TYPE (lv_tab).
  ASSIGN lr_wa->* TO <ls_wa>.
  PERFORM set_comp USING 'PARAM' iv_name CHANGING <ls_wa>.
  PERFORM set_comp USING 'PVALUE' iv_value CHANGING <ls_wa>.
  MODIFY (lv_tab) FROM <ls_wa>.
  IF sy-subrc <> 0.
    WRITE: / 'Installation parameter could not be saved:', iv_name.
    gv_err = 'X'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
* Saves a parameter only when it does not exist yet.
FORM save_param_default USING iv_name  TYPE c
                              iv_value TYPE c.
  DATA: lv_tab(30)    TYPE c VALUE 'ZCHE_IMAP_PARAM',
        lv_value(255) TYPE c.

  SELECT SINGLE pvalue FROM (lv_tab) INTO lv_value
    WHERE param = iv_name.
  IF sy-subrc = 0 AND NOT lv_value IS INITIAL.
    EXIT.
  ENDIF.
  PERFORM save_param USING iv_name iv_value.
ENDFORM.

*---------------------------------------------------------------
* Preflight every source before changing even the first include.
FORM preflight_programs.
  REFRESH gt_src.
  PERFORM fill_common.
  PERFORM compare_program USING 'ZCHE_IMAP_COMMON'.
  REFRESH gt_src.
  PERFORM fill_io.
  PERFORM compare_program USING 'ZCHE_IMAP_IO'.
  REFRESH gt_src.
  PERFORM fill_handler.
  PERFORM compare_program USING 'ZCHE_IMAP_HANDLER_DEMO'.
  REFRESH gt_src.
  PERFORM fill_inbound.
  PERFORM compare_program USING 'ZCHE_IMAP_INBOUND'.
  REFRESH gt_src.
  PERFORM fill_config.
  PERFORM compare_program USING 'ZCHE_IMAP_CONFIG'.
  REFRESH gt_src.
  PERFORM fill_monitor.
  PERFORM compare_program USING 'ZCHE_IMAP_MONITOR'.
ENDFORM.

FORM compare_program USING iv_prog TYPE c.
  DATA: lt_source TYPE STANDARD TABLE OF abapsource,
        ls_source TYPE abapsource,
        lv_owned(1) TYPE c,
        lv_prog(40) TYPE c.

  lv_prog = iv_prog.
  READ REPORT lv_prog INTO lt_source.
  IF sy-subrc <> 0.
    IF p_prg IS INITIAL.
      WRITE: / 'Required program missing:', iv_prog.
      gv_err = 'X'.
    ENDIF.
  ELSE.
    LOOP AT lt_source INTO ls_source.
      IF ls_source CS 'Project: abap-imap-inbound'.
        lv_owned = 'X'.
        EXIT.
      ENDIF.
    ENDLOOP.
    IF lv_owned IS INITIAL.
      WRITE: / 'Existing program is not owned by this project:',
               iv_prog.
      gv_err = 'X'.
      EXIT.
    ENDIF.
    IF lt_source[] = gt_src[].
      EXIT.
    ENDIF.
    IF p_prg IS INITIAL OR p_over IS INITIAL.
      WRITE: / 'Program differs; update must be explicit:', iv_prog,
             / 'Select Programs and Overwrite, or retain old setup.'.
      gv_err = 'X'.
    ENDIF.
  ENDIF.
ENDFORM.

FORM backup_program USING iv_prog TYPE c.
  DATA: ls_change TYPE ty_change, ls_backup TYPE ty_backup,
        ls_textbak TYPE ty_textbak,
        lt_source TYPE STANDARD TABLE OF abapsource,
        ls_source TYPE abapsource,
        lt_text TYPE STANDARD TABLE OF textpool,
        ls_text TYPE textpool, lv_prog(40) TYPE c.

  lv_prog = iv_prog.
  ls_change-prog = iv_prog.
  READ REPORT lv_prog INTO lt_source.
  IF sy-subrc = 0.
    ls_change-existed = 'X'.
    LOOP AT lt_source INTO ls_source.
      ls_backup-prog = iv_prog.
      ls_backup-source = ls_source.
      APPEND ls_backup TO gt_backup.
    ENDLOOP.
    READ TEXTPOOL lv_prog INTO lt_text LANGUAGE sy-langu.
    LOOP AT lt_text INTO ls_text.
      ls_textbak-prog = iv_prog.
      ls_textbak-text = ls_text.
      APPEND ls_textbak TO gt_textbak.
    ENDLOOP.
  ENDIF.
  APPEND ls_change TO gt_change.
ENDFORM.

FORM restore_programs.
  DATA: ls_change TYPE ty_change, ls_backup TYPE ty_backup,
        ls_textbak TYPE ty_textbak,
        lt_source TYPE STANDARD TABLE OF abapsource,
        lt_text TYPE STANDARD TABLE OF textpool,
        lv_prog(40) TYPE c, lv_index TYPE i.

* Only programs created by this invocation may be removed here.
  DESCRIBE TABLE gt_change LINES lv_index.
  WHILE lv_index > 0.
    READ TABLE gt_change INTO ls_change INDEX lv_index.
    IF ls_change-existed IS INITIAL.
      PERFORM delete_program USING ls_change-prog.
    ENDIF.
    lv_index = lv_index - 1.
  ENDWHILE.
  LOOP AT gt_change INTO ls_change WHERE existed = 'X'.
    REFRESH: lt_source, lt_text.
    lv_prog = ls_change-prog.
    LOOP AT gt_backup INTO ls_backup WHERE prog = lv_prog.
      APPEND ls_backup-source TO lt_source.
    ENDLOOP.
    INSERT REPORT lv_prog FROM lt_source.
    IF sy-subrc <> 0.
      WRITE: / 'RESTORE FAILED; restore source manually:', lv_prog.
      CONTINUE.
    ENDIF.
    LOOP AT gt_textbak INTO ls_textbak WHERE prog = lv_prog.
      APPEND ls_textbak-text TO lt_text.
    ENDLOOP.
    INSERT TEXTPOOL lv_prog FROM lt_text LANGUAGE sy-langu.
    IF sy-subrc <> 0.
      WRITE: / 'RESTORE FAILED; restore text pool:', lv_prog.
    ELSE.
      WRITE: / 'Previous program and texts restored:', lv_prog.
    ENDIF.
  ENDLOOP.
ENDFORM.

FORM finish_texts.
  DATA ls_change TYPE ty_change.

  LOOP AT gt_change INTO ls_change.
    IF ls_change-prog = 'ZCHE_IMAP_INBOUND'
       OR ls_change-prog = 'ZCHE_IMAP_CONFIG'
       OR ls_change-prog = 'ZCHE_IMAP_MONITOR'.
      PERFORM set_texts USING ls_change-prog.
    ENDIF.
  ENDLOOP.
ENDFORM.

*---------------------------------------------------------------
FORM create_programs.
  REFRESH gt_src.
  PERFORM fill_common.
  PERFORM create_program USING 'ZCHE_IMAP_COMMON' 'I'
                               'ZCHE_IMAP: common types and forms'.
  REFRESH gt_src.
  PERFORM fill_io.
  PERFORM create_program USING 'ZCHE_IMAP_IO' 'I'
                               'ZCHE_IMAP: file read and write'.
  REFRESH gt_src.
  PERFORM fill_handler.
  PERFORM create_program USING 'ZCHE_IMAP_HANDLER_DEMO' 'S'
                               'ZCHE_IMAP: sample business logic'.
  REFRESH gt_src.
  PERFORM fill_inbound.
  PERFORM create_program USING 'ZCHE_IMAP_INBOUND' '1'
                               'ZCHE_IMAP: IMAP mail processing'.
  REFRESH gt_src.
  PERFORM fill_config.
  PERFORM create_program USING 'ZCHE_IMAP_CONFIG' '1'
                               'ZCHE_IMAP: mailbox profiles'.
  REFRESH gt_src.
  PERFORM fill_monitor.
  PERFORM create_program USING 'ZCHE_IMAP_MONITOR' '1'
                               'ZCHE_IMAP: mail monitor'.

  PERFORM check_syntax USING 'ZCHE_IMAP_HANDLER_DEMO'.
  PERFORM check_syntax USING 'ZCHE_IMAP_INBOUND'.
  PERFORM check_syntax USING 'ZCHE_IMAP_CONFIG'.
  PERFORM check_syntax USING 'ZCHE_IMAP_MONITOR'.
* Previous-version includes are kept for explicit manual recovery.
ENDFORM.

*---------------------------------------------------------------
FORM create_program USING iv_name  TYPE c
                          iv_type  TYPE c
                          iv_title TYPE c.
  DATA: lv_prog  LIKE rglif-include,
        lv_ptype LIKE rglif-progtype,
        lv_title LIKE rglif-title,
        lv_devc  LIKE rglif-devclass,
        lv_name(40) TYPE c,
        lv_new(1)   TYPE c,
        lv_ok(1)    TYPE c.

  lv_prog  = iv_name.
  lv_ptype = iv_type.
  lv_title = iv_title.
  lv_devc  = '$TMP'.

  SELECT SINGLE name FROM trdir INTO lv_name WHERE name = lv_prog.
  IF sy-subrc = 0.
    IF p_over IS INITIAL.
      WRITE: / 'Program already exists, skipped:', lv_prog.
      EXIT.
    ENDIF.
    PERFORM backup_program USING lv_prog.
    INSERT REPORT lv_prog FROM gt_src.
    IF sy-subrc <> 0.
      WRITE: / 'Program update failed:', lv_prog.
      gv_err = 'X'.
      EXIT.
    ENDIF.
    WRITE: / 'Program updated:', lv_prog.
    IF lv_prog = 'ZCHE_IMAP_INBOUND'.
      gv_newinb = 'X'.
    ENDIF.
    EXIT.
  ENDIF.

  PERFORM backup_program USING lv_prog.
  PERFORM fm_exists USING 'RPY_PROGRAM_INSERT' CHANGING lv_ok.
  IF lv_ok IS INITIAL.
    WRITE: / 'RPY_PROGRAM_INSERT missing: create program', lv_prog,
             'manually in SE38.'.
    gv_err = 'X'.
    EXIT.
  ENDIF.

* Newer releases: without dialog and with the Unicode check flag
  PERFORM fm_has_param USING 'RPY_PROGRAM_INSERT' 'UCCHECK'
                       CHANGING lv_new.
  IF NOT lv_new IS INITIAL.
    CALL FUNCTION 'RPY_PROGRAM_INSERT'
      EXPORTING
        development_class = lv_devc
        program_name      = lv_prog
        program_type      = lv_ptype
        title_string      = lv_title
        suppress_dialog   = 'X'
        uccheck           = gv_uni
      TABLES
        source            = gt_src
      EXCEPTIONS
        already_exists    = 1
        cancelled         = 2
        name_not_allowed  = 3
        permission_error  = 4
        OTHERS            = 5.
  ELSE.
    CALL FUNCTION 'RPY_PROGRAM_INSERT'
      EXPORTING
        development_class = lv_devc
        program_name      = lv_prog
        program_type      = lv_ptype
        title_string      = lv_title
      TABLES
        source            = gt_src
      EXCEPTIONS
        already_exists    = 1
        cancelled         = 2
        name_not_allowed  = 3
        permission_error  = 4
        OTHERS            = 5.
  ENDIF.
  IF sy-subrc <> 0.
    WRITE: / 'Program could not be created:', lv_prog,
           / '  RPY_PROGRAM_INSERT code', sy-subrc.
    gv_err = 'X'.
  ELSE.
    WRITE: / 'Program created:', lv_prog.
    IF lv_prog = 'ZCHE_IMAP_INBOUND'.
      gv_newinb = 'X'.
    ENDIF.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
FORM set_texts USING iv_prog TYPE c.
  DATA: lt_tp       TYPE STANDARD TABLE OF textpool,
        ls_tp       TYPE textpool,
        ls_txt      TYPE ty_txt,
        lv_prog(40) TYPE c.

  lv_prog = iv_prog.
  LOOP AT gt_txt INTO ls_txt WHERE prog = iv_prog.
    CLEAR ls_tp.
    ls_tp-id  = ls_txt-id.
    ls_tp-key = ls_txt-key.
    IF ls_txt-id = 'S'.
*     In selection texts the first 8 characters are reserved
      ls_tp-entry+8 = ls_txt-text.
    ELSE.
      ls_tp-entry = ls_txt-text.
    ENDIF.
    ls_tp-length = STRLEN( ls_tp-entry ).
    APPEND ls_tp TO lt_tp.
  ENDLOOP.
  INSERT TEXTPOOL lv_prog FROM lt_tp LANGUAGE sy-langu.
  IF sy-subrc <> 0.
    WRITE: / 'Text pool could not be updated:', lv_prog.
    gv_err = 'X'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
FORM check_syntax USING iv_prog TYPE c.
  DATA: lt_src      TYPE STANDARD TABLE OF abapsource,
        lv_prog(40) TYPE c,
        lv_msg(240) TYPE c,
        lv_word(72) TYPE c,
        lv_line     TYPE i.

  lv_prog = iv_prog.
  READ REPORT lv_prog INTO lt_src.
  IF sy-subrc <> 0.
    EXIT.
  ENDIF.
  SYNTAX-CHECK FOR lt_src MESSAGE lv_msg LINE lv_line
               WORD lv_word PROGRAM lv_prog.
  IF sy-subrc = 0.
    WRITE: / 'Syntax check without errors:', lv_prog.
  ELSE.
    FORMAT COLOR COL_NEGATIVE INTENSIFIED OFF.
    WRITE: / 'Syntax error:', lv_prog, 'line', lv_line,
           / '  ', lv_msg(130),
           / '  Word:', lv_word.
    FORMAT COLOR OFF.
    gv_err = 'X'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
FORM delete_program USING iv_name TYPE c.
  DATA: lv_prog     LIKE sy-repid,
        lv_name(40) TYPE c,
        lv_ok(1)    TYPE c,
        lv_pop(1)   TYPE c.

  lv_prog = iv_name.
  SELECT SINGLE name FROM trdir INTO lv_name WHERE name = lv_prog.
  IF sy-subrc <> 0.
    EXIT.
  ENDIF.
  PERFORM fm_exists USING 'RS_DELETE_PROGRAM' CHANGING lv_ok.
  PERFORM fm_has_param USING 'RS_DELETE_PROGRAM' 'SUPPRESS_POPUP'
                       CHANGING lv_pop.
  IF lv_ok IS INITIAL OR lv_pop IS INITIAL.
    WRITE: / 'Delete manually in SE38:', lv_prog.
    EXIT.
  ENDIF.
  CALL FUNCTION 'RS_DELETE_PROGRAM'
    EXPORTING
      program        = lv_prog
      suppress_popup = 'X'
    EXCEPTIONS
      OTHERS         = 1.
  IF sy-subrc = 0.
    WRITE: / 'Program deleted:', lv_prog.
  ELSE.
    WRITE: / 'Program could not be deleted (use SE38):', lv_prog.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
FORM create_commands.
  DATA: lv_exe(128) TYPE c,
        lv_pre(128) TYPE c,
        lv_ok(1)    TYPE c,
        lv_mod(1)   TYPE c.

  PERFORM fm_exists USING 'SXPG_COMMAND_INSERT' CHANGING lv_ok.
  PERFORM fm_exists USING 'SXPG_COMMAND_MODIFY' CHANGING lv_mod.
  PERFORM snapshot_commands.
  IF NOT gv_err IS INITIAL.
    EXIT.
  ENDIF.
  IF sy-opsys(7) = 'Windows'.
    lv_exe = 'C:\Windows\System32\WindowsPowerShell\v1.0\'.
    CONCATENATE lv_exe 'powershell.exe' INTO lv_exe.
    lv_pre = '-NoP -NonI -EP Bypass -File'.
  ELSE.
    lv_exe = '/usr/bin/pwsh'.
    lv_pre = '-NoP -NonI -File'.
  ENDIF.
  PERFORM create_command USING 'ZCHE_IMAP_LIST' lv_exe lv_pre
                               'list' lv_ok lv_mod.
  PERFORM create_command USING 'ZCHE_IMAP_FETCH' lv_exe lv_pre
                               'fetch' lv_ok lv_mod.
  PERFORM create_command USING 'ZCHE_IMAP_DONE' lv_exe lv_pre
                               'done' lv_ok lv_mod.
  PERFORM create_command USING 'ZCHE_IMAP_TEST' lv_exe lv_pre
                               'test' lv_ok lv_mod.
ENDFORM.

FORM snapshot_commands.
  DATA: lv_ok(1) TYPE c,
        lt_commands TYPE STANDARD TABLE OF sxpgcolist,
        ls_command TYPE sxpgcolist, ls_backup TYPE ty_cmdbak,
        lv_name LIKE sxpgcolist-name VALUE 'ZCHE_IMAP_*'.

  PERFORM fm_exists USING 'SXPG_COMMAND_LIST_GET' CHANGING lv_ok.
  IF lv_ok IS INITIAL.
    WRITE: / 'Cannot back up SM69 commands; maintain them manually.'.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  CALL FUNCTION 'SXPG_COMMAND_LIST_GET'
    EXPORTING commandname = lv_name operatingsystem = sy-opsys
    TABLES command_list = lt_commands
    EXCEPTIONS OTHERS = 1.
  IF sy-subrc <> 0.
    WRITE: / 'SM69 backup failed; no commands changed.'.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  LOOP AT lt_commands INTO ls_command.
    IF ls_command-name = 'ZCHE_IMAP_LIST'
       OR ls_command-name = 'ZCHE_IMAP_FETCH'
       OR ls_command-name = 'ZCHE_IMAP_DONE'
       OR ls_command-name = 'ZCHE_IMAP_TEST'.
      IF ls_command-parameters NS 'imap.ps1'.
        WRITE: / 'Unknown SM69 name collision:', ls_command-name.
        gv_err = 'X'.
      ELSE.
        ls_backup-command = ls_command.
        ls_backup-existed = 'X'.
        APPEND ls_backup TO gt_cmdbak.
      ENDIF.
    ENDIF.
  ENDLOOP.
ENDFORM.

FORM restore_commands.
  DATA ls_backup TYPE ty_cmdbak.

  IF gv_cmdwrite IS INITIAL.
    EXIT.
  ENDIF.
  LOOP AT gt_cmdbak INTO ls_backup.
    CALL FUNCTION 'SXPG_COMMAND_MODIFY'
      EXPORTING command = ls_backup-command
      EXCEPTIONS OTHERS = 1.
    IF sy-subrc <> 0.
      WRITE: / 'RESTORE SM69 MANUALLY:', ls_backup-command-name,
             / ls_backup-command-opcommand,
             / ls_backup-command-parameters.
    ELSE.
      WRITE: / 'Previous SM69 command restored:',
               ls_backup-command-name.
    ENDIF.
  ENDLOOP.
  COMMIT WORK.
  WRITE: / 'Review/remove any newly created ZCHE_IMAP commands in SM69.'.
ENDFORM.

*---------------------------------------------------------------
* All commands take additional parameters (profile, UID,
* UIDVALIDITY).
*---------------------------------------------------------------
FORM create_command USING iv_name   TYPE c
                          iv_exe    TYPE c
                          iv_pre    TYPE c
                          iv_action TYPE c
                          iv_ins_ok TYPE c
                          iv_mod_ok TYPE c.
  DATA: ls_cmd        TYPE sxpgcolist,
        lv_script(90) TYPE c,
         lv_quoted(94) TYPE c,
         lv_parameters(255) TYPE c,
        lv_sep(1)     TYPE c,
        lv_len        TYPE i.

  IF NOT gv_err IS INITIAL.
    EXIT.
  ENDIF.
  lv_script = p_root.
  IF lv_script CA '/'.
    lv_sep = '/'.
  ELSE.
    lv_sep = '\'.
  ENDIF.
  lv_len = STRLEN( lv_script ) - 1.
  IF lv_len >= 0.
    IF lv_script+lv_len(1) <> lv_sep.
      CONCATENATE lv_script lv_sep INTO lv_script.
    ENDIF.
  ENDIF.
  CONCATENATE lv_script 'bin' lv_sep 'imap.ps1' INTO lv_script.
* SAPXPG passes Unix parameters without a shell, so quotes would
* reach pwsh literally. Quote only on Windows; no spaces on Unix.
  IF lv_sep = '/'.
    lv_len = STRLEN( lv_script ).
    IF lv_script(lv_len) CA ' '.
      WRITE: / 'Server folder must not contain spaces on Unix.'.
      gv_err = 'X'.
      EXIT.
    ENDIF.
    lv_quoted = lv_script.
  ELSE.
    CONCATENATE '"' lv_script '"' INTO lv_quoted.
  ENDIF.
* Reserve the largest valid additional argument block (61 chars)
* in the old SXPG 128-character combined parameter limit.
  lv_len = STRLEN( iv_pre ) + STRLEN( lv_quoted ) +
           STRLEN( iv_action ) + 3 + 61.
  IF lv_len > 128.
    WRITE: / 'SM69 parameters exceed old limit; use shorter ROOT.'.
    gv_err = 'X'.
    EXIT.
  ENDIF.

  ls_cmd-name      = iv_name.
  ls_cmd-opsystem  = sy-opsys.
  ls_cmd-opcommand = iv_exe.
  CONCATENATE iv_pre lv_quoted iv_action INTO lv_parameters
              SEPARATED BY space.
  ls_cmd-parameters = lv_parameters.
  IF ls_cmd-parameters <> lv_parameters.
    WRITE: / 'SM69 parameter capacity exceeded; use a shorter root.'.
    gv_err = 'X'.
    EXIT.
  ENDIF.
* ADDPAR may not exist in every release: it is filled dynamically
  PERFORM set_comp USING 'ADDPAR' 'X' CHANGING ls_cmd.

  IF iv_ins_ok IS INITIAL.
    WRITE: / 'Define manually in SM69:', iv_name,
           / '  Operating system:', ls_cmd-opsystem,
           / '  Command:', ls_cmd-opcommand(70),
           / '  Parameters:', ls_cmd-parameters(100),
           / '  Allow additional parameters: yes'.
    gv_err = 'X'.
    EXIT.
  ENDIF.

  CALL FUNCTION 'SXPG_COMMAND_INSERT'
    EXPORTING
      command                = ls_cmd
    EXCEPTIONS
      command_already_exists = 1
      no_permission          = 2
      parameters_wrong       = 3
      foreign_lock           = 4
      system_failure         = 5
      OTHERS                 = 6.
  IF sy-subrc = 0.
    gv_cmdwrite = 'X'.
    WRITE: / 'SM69 command created:', iv_name.
    EXIT.
  ENDIF.
  IF sy-subrc = 1 AND NOT iv_mod_ok IS INITIAL.
    CALL FUNCTION 'SXPG_COMMAND_MODIFY'
      EXPORTING
        command = ls_cmd
      EXCEPTIONS
        OTHERS  = 1.
    IF sy-subrc = 0.
      gv_cmdwrite = 'X'.
      WRITE: / 'SM69 command updated:', iv_name.
      EXIT.
    ENDIF.
  ENDIF.
  WRITE: / 'SM69 command could not be created:', iv_name,
           '(check in SM69)'.
  gv_err = 'X'.
ENDFORM.

*---------------------------------------------------------------
* Server setup test: script, policy, curl, folders
*---------------------------------------------------------------
FORM run_check.
  DATA: lt_prot      TYPE STANDARD TABLE OF btcxpm,
        ls_prot      TYPE btcxpm,
        lv_cmd       LIKE sxpgcolist-name,
         lv_last(128) TYPE c,
         lv_version(10) TYPE c,
         lv_protocol(1) TYPE c,
         lv_root(128) TYPE c, lv_expected(128) TYPE c,
         lv_len TYPE i.

  lv_cmd = 'ZCHE_IMAP_TEST'.
  CALL FUNCTION 'SXPG_COMMAND_EXECUTE'
    EXPORTING
      commandname   = lv_cmd
    TABLES
      exec_protocol = lt_prot
    EXCEPTIONS
      OTHERS        = 1.
  ULINE.
  IF sy-subrc <> 0.
    WRITE: / 'ZCHE_IMAP_TEST could not be run, code', sy-subrc,
           / 'Check the SM69 command and the server folder.'.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  WRITE: / 'Server setup test:'.
  LOOP AT lt_prot INTO ls_prot.
    IF NOT ls_prot-message IS INITIAL.
      WRITE: / '  ', ls_prot-message.
      lv_last = ls_prot-message.
      IF ls_prot-message(8) = 'VERSION '.
        lv_version = ls_prot-message+8.
      ELSEIF ls_prot-message = 'PROTOCOL 2'.
        lv_protocol = 'X'.
      ELSEIF ls_prot-message(5) = 'ROOT '.
        lv_root = ls_prot-message+5.
      ENDIF.
    ENDIF.
  ENDLOOP.
  SHIFT lv_last LEFT DELETING LEADING space.
  IF lv_last(3) <> 'OK '.
    WRITE: / 'Server side not ready: Basis must run the',
             'setup-server script (see README).'.
    gv_err = 'X'.
  ENDIF.
  IF lv_version <> gc_version OR lv_protocol IS INITIAL.
    WRITE: / 'Script version/protocol mismatch; update both modules.'.
    gv_err = 'X'.
  ENDIF.
  lv_expected = p_root.
  lv_len = STRLEN( lv_expected ) - 1.
  IF lv_len >= 0.
    IF lv_expected+lv_len(1) = '/'
       OR lv_expected+lv_len(1) = '\'.
      CLEAR lv_expected+lv_len(1).
    ENDIF.
  ENDIF.
  lv_len = STRLEN( lv_root ) - 1.
  IF lv_len >= 0.
    IF lv_root+lv_len(1) = '/' OR lv_root+lv_len(1) = '\'.
      CLEAR lv_root+lv_len(1).
    ENDIF.
  ENDIF.
  IF lv_root <> lv_expected.
    WRITE: / 'Script policy ROOT differs from installer server folder.'.
    gv_err = 'X'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
* Uninstall: programs, DDIC objects. SM69 commands manually.
*---------------------------------------------------------------
FORM uninstall.
  DATA: lv_answer(1) TYPE c,
        lv_ok(1)     TYPE c,
        ls_tab       TYPE ty_tab,
        ls_dtel      TYPE ty_dtel,
        ls_dom       TYPE ty_dom,
        lv_type(1)   TYPE c.

  PERFORM guard_uninstall.
  IF NOT gv_err IS INITIAL.
    WRITE: / 'Removal stopped; review objects manually in SE11/SE38.'.
    EXIT.
  ENDIF.
  PERFORM fm_exists USING 'POPUP_TO_CONFIRM' CHANGING lv_ok.
  IF NOT lv_ok IS INITIAL.
    CALL FUNCTION 'POPUP_TO_CONFIRM'
      EXPORTING
        titlebar              = 'ZCHE_IMAP uninstall'
        text_question         =
          'Delete ZCHE_IMAP tables and data in ALL SAP CLIENTS?'
        text_button_1         = 'Delete'
        text_button_2         = 'Cancel'
        display_cancel_button = ' '
      IMPORTING
        answer                = lv_answer
      EXCEPTIONS
        OTHERS                = 1.
  ELSE.
    CALL FUNCTION 'POPUP_TO_CONFIRM_STEP'
      EXPORTING
        textline1 = 'Delete ZCHE_IMAP data in ALL SAP CLIENTS?'
        titel     = 'ZCHE_IMAP uninstall'
      IMPORTING
        answer    = lv_answer
      EXCEPTIONS
        OTHERS    = 1.
    IF lv_answer = 'J'.
      lv_answer = '1'.
    ENDIF.
  ENDIF.
  IF lv_answer <> '1'.
    WRITE: / 'Uninstall cancelled.'.
    EXIT.
  ENDIF.

  PERFORM delete_program USING 'ZCHE_IMAP_MONITOR'.
  PERFORM delete_program USING 'ZCHE_IMAP_CONFIG'.
  PERFORM delete_program USING 'ZCHE_IMAP_INBOUND'.
  PERFORM delete_program USING 'ZCHE_IMAP_HANDLER_DEMO'.
  PERFORM delete_program USING 'ZCHE_IMAP_IO'.
  PERFORM delete_program USING 'ZCHE_IMAP_COMMON'.

  PERFORM fm_exists USING 'RS_DD_DELETE_OBJ' CHANGING lv_ok.
  IF lv_ok IS INITIAL.
    WRITE: / 'RS_DD_DELETE_OBJ missing: delete the ZCHE_IMAP_* DDIC',
             'objects in SE11.'.
  ELSE.
    LOOP AT gt_tab INTO ls_tab.
      IF ls_tab-class = 'TRANSP'.
        lv_type = 'T'.
      ELSE.
        lv_type = 'S'.
      ENDIF.
      PERFORM delete_ddic USING ls_tab-name lv_type.
    ENDLOOP.
    LOOP AT gt_dtel INTO ls_dtel.
      PERFORM delete_ddic USING ls_dtel-name 'E'.
    ENDLOOP.
    LOOP AT gt_dom INTO ls_dom.
      PERFORM delete_ddic USING ls_dom-name 'D'.
    ENDLOOP.
  ENDIF.
  ULINE.
  WRITE: / 'Uninstall finished. Delete the commands ZCHE_IMAP_LIST,',
           'ZCHE_IMAP_FETCH, ZCHE_IMAP_DONE, ZCHE_IMAP_TEST in SM69;',
         / 'Basis deletes the server folders.'.
ENDFORM.

* Only a recognized setup with an exact known schema is removable.
FORM guard_uninstall.
  DATA: lv_table(30) TYPE c VALUE 'ZCHE_IMAP_PARAM',
        lv_value(255) TYPE c, lv_client LIKE sy-mandt,
        ls_tab TYPE ty_tab, ls_expected TYPE ty_fld,
        lt_fields TYPE STANDARD TABLE OF dd03l, ls_field TYPE dd03l,
        lv_name(30) TYPE c, ls_dom TYPE ty_dom,
        ls_dtel TYPE ty_dtel, lv_domain LIKE dd04l-domname,
        lv_dtype LIKE dd01l-datatype, lv_length LIKE dd01l-leng.

  SELECT SINGLE tabname FROM dd02l INTO lv_name
    WHERE tabname = lv_table AND as4local = 'A'.
  IF sy-subrc <> 0.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  SELECT SINGLE pvalue FROM (lv_table) INTO lv_value
    WHERE param = 'OWNER'.
  IF sy-subrc <> 0 OR lv_value <> 'ABAP_IMAP_INBOUND'.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  SELECT SINGLE pvalue FROM (lv_table) INTO lv_value
    WHERE param = 'VERSION'.
  IF sy-subrc <> 0 OR lv_value <> gc_version.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  SELECT SINGLE pvalue FROM (lv_table) INTO lv_value
    WHERE param = 'EXEC_HOST'.
  IF sy-subrc <> 0 OR lv_value <> sy-host.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  AUTHORITY-CHECK OBJECT 'S_TABU_CLI'
    ID 'CLIIDMAINT' FIELD 'X'.
  IF sy-subrc <> 0.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  lv_table = 'ZCHE_IMAP_PROF'.
  SELECT SINGLE mandt FROM (lv_table) CLIENT SPECIFIED
    INTO lv_client WHERE mandt <> sy-mandt AND active = 'X'.
  IF sy-subrc = 0.
    WRITE: / 'Another client has active profiles:', lv_client.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  CLEAR: p_prg, p_over.
  PERFORM detect_mode.
  PERFORM preflight_programs.
  LOOP AT gt_tab INTO ls_tab.
    REFRESH lt_fields.
    SELECT * FROM dd03l INTO TABLE lt_fields
      WHERE tabname = ls_tab-name AND as4local = 'A'.
    LOOP AT lt_fields INTO ls_field.
      READ TABLE gt_fld INTO ls_expected
        WITH KEY tab = ls_tab-name field = ls_field-fieldname.
      IF sy-subrc <> 0.
        gv_err = 'X'.
      ELSEIF ls_field-rollname <> ls_expected-dtel
             OR ls_field-keyflag <> ls_expected-key.
        gv_err = 'X'.
      ENDIF.
    ENDLOOP.
    LOOP AT gt_fld INTO ls_expected WHERE tab = ls_tab-name.
      READ TABLE lt_fields WITH KEY fieldname = ls_expected-field
           TRANSPORTING NO FIELDS.
      IF sy-subrc <> 0.
        gv_err = 'X'.
      ENDIF.
    ENDLOOP.
  ENDLOOP.
  LOOP AT gt_dom INTO ls_dom.
    SELECT SINGLE datatype leng FROM dd01l
      INTO (lv_dtype, lv_length)
      WHERE domname = ls_dom-name AND as4local = 'A'.
    IF sy-subrc <> 0 OR lv_dtype <> ls_dom-dtype
       OR lv_length <> ls_dom-len.
      gv_err = 'X'.
    ENDIF.
  ENDLOOP.
  LOOP AT gt_dtel INTO ls_dtel.
    SELECT SINGLE domname FROM dd04l INTO lv_domain
      WHERE rollname = ls_dtel-name AND as4local = 'A'.
    IF sy-subrc <> 0 OR lv_domain <> ls_dtel-dom.
      gv_err = 'X'.
    ENDIF.
  ENDLOOP.
ENDFORM.

*---------------------------------------------------------------
FORM delete_ddic USING iv_name TYPE c
                       iv_type TYPE c.
  DATA: lv_name LIKE rsedd0-ddobjname,
        lv_type LIKE rsedd0-ddobjtype,
        lv_corr LIKE e070-trkorr.

  lv_name = iv_name.
  lv_type = iv_type.
  CALL FUNCTION 'RS_DD_DELETE_OBJ'
    EXPORTING
      no_ask               = 'X'
      objname              = lv_name
      objtype              = lv_type
    CHANGING
      corrnum              = lv_corr
    EXCEPTIONS
      not_executed         = 1
      object_not_found     = 2
      object_not_specified = 3
      permission_failure   = 4
      dialog_needed        = 5
      OTHERS               = 6.
  IF sy-subrc = 0.
    WRITE: / 'Deleted:', iv_name.
  ELSEIF sy-subrc <> 2.
    WRITE: / 'Could not be deleted (use SE11):', iv_name, sy-subrc.
  ENDIF.
ENDFORM.

