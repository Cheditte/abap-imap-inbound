INITIALIZATION.
  t_b1    = 'Installation'.
  t_b2    = 'Settings'.
  t_b3    = 'Uninstall'.
  c_ddic  = 'DDIC: domains, data elements, tables, structures'.
  c_prg   = 'Programs and includes'.
  c_cmd   = 'SM69 commands ZCHE_IMAP_LIST/FETCH/DONE/TEST'.
  c_chk   = 'Test the server setup at the end'.
  c_over  = 'Overwrite existing programs (update)'.
  c_root  = 'Server folder'.
  c_mode  = 'Code page'.
  c_mhlp  = 'A automatic, L non-Unicode, U Unicode'.
  c_cp    = 'File code page'.
  c_cphlp = 'If non-Unicode (Turkish: 1254)'.
  c_del   = 'UNINSTALL: shared objects and ALL CLIENTS data (lost)'.
  IF sy-opsys(7) = 'Windows'.
    p_root = 'C:\sapimap\'.
  ELSE.
    p_root = '/usr/sap/sapimap/'.
  ENDIF.
  PERFORM load_params.

START-OF-SELECTION.
  CLEAR: gv_err, gv_lock, gv_setup_lock, gv_cmdwrite,
         gv_newinb, gv_same.
  REFRESH: gt_change, gt_backup, gt_textbak, gt_cmdbak.
  PERFORM parse_defs.
  PERFORM check_authority.
  IF NOT gv_err IS INITIAL OR NOT gv_initerr IS INITIAL.
    WRITE: / 'Installation stopped before making changes.'.
    STOP.
  ENDIF.
  PERFORM install_lock.
  IF NOT gv_err IS INITIAL.
    WRITE: / 'Stop active ZCHE_IMAP jobs/configuration and retry.'.
    STOP.
  ENDIF.
  IF NOT p_del IS INITIAL.
    PERFORM profile_lock.
    IF gv_err IS INITIAL.
      PERFORM uninstall.
    ENDIF.
  ELSE.
    PERFORM install.
  ENDIF.
  IF NOT gv_lock IS INITIAL.
    CALL FUNCTION 'DEQUEUE_E_TABLE'
      EXPORTING tabname = 'ZCHE_IMAP_PROF' _scope = '1'.
  ENDIF.
  IF NOT gv_setup_lock IS INITIAL.
    CALL FUNCTION 'DEQUEUE_E_TABLE'
      EXPORTING tabname = 'ZCHE_IMAP_SETUP' _scope = '1'.
  ENDIF.

*---------------------------------------------------------------
FORM install.
  WRITE: / 'abap-imap-inbound installation, version', gc_version.
  ULINE.
  PERFORM detect_mode.
  IF p_chk IS INITIAL.
    WRITE: / 'Server check is required before saving this setup.'.
    EXIT.
  ENDIF.
  PERFORM validate_root.
  PERFORM preflight_programs.
  IF NOT gv_err IS INITIAL.
    WRITE: / 'Preflight failed; no installation changes made.'.
    EXIT.
  ENDIF.
  IF NOT p_ddic IS INITIAL.
    PERFORM create_ddic.
  ENDIF.
  IF gv_err IS INITIAL.
    PERFORM profile_lock.
  ENDIF.
  IF NOT p_prg IS INITIAL AND gv_err IS INITIAL.
    PERFORM create_programs.
  ENDIF.
  IF NOT p_cmd IS INITIAL AND gv_err IS INITIAL.
    PERFORM create_commands.
  ENDIF.
  IF NOT p_chk IS INITIAL AND gv_err IS INITIAL.
    PERFORM run_check.
  ENDIF.
  IF gv_err IS INITIAL.
    PERFORM finish_texts.
  ENDIF.
  IF gv_err IS INITIAL.
    PERFORM save_params.
  ENDIF.
  IF NOT gv_err IS INITIAL.
    PERFORM restore_commands.
    PERFORM restore_programs.
  ENDIF.
  ULINE.
  IF gv_err IS INITIAL.
    FORMAT COLOR COL_POSITIVE.
    WRITE: / 'Installation complete.'.
    FORMAT COLOR OFF.
    PERFORM next_steps.
  ELSE.
    FORMAT COLOR COL_NEGATIVE.
    WRITE: / 'Installation finished with errors; see the lines above.'.
    FORMAT COLOR OFF.
  ENDIF.
ENDFORM.

* Serialize installers without locking a DDIC object being created.
* Scope 1 survives commits made by repository/DDIC APIs.
FORM install_lock.
  DATA lv_ok(1) TYPE c.

  PERFORM fm_exists USING 'ENQUEUE_E_TABLE' CHANGING lv_ok.
  IF lv_ok IS INITIAL.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  PERFORM fm_exists USING 'DEQUEUE_E_TABLE' CHANGING lv_ok.
  IF lv_ok IS INITIAL.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  CALL FUNCTION 'ENQUEUE_E_TABLE'
    EXPORTING tabname = 'ZCHE_IMAP_SETUP' _scope = '1'
    EXCEPTIONS OTHERS = 1.
  IF sy-subrc <> 0.
    gv_err = 'X'.
  ELSE.
    gv_setup_lock = 'X'.
  ENDIF.
ENDFORM.

* Profile jobs and configuration use scoped locks on this table.
* Take the generic lock only after DDIC maintenance; DDIF_TABL_PUT
* must be able to save the table definition first.
FORM profile_lock.
  CALL FUNCTION 'ENQUEUE_E_TABLE'
    EXPORTING tabname = 'ZCHE_IMAP_PROF' _scope = '1'
    EXCEPTIONS OTHERS = 1.
  IF sy-subrc <> 0.
    WRITE: / 'Stop active ZCHE_IMAP jobs/configuration and retry.'.
    gv_err = 'X'.
  ELSE.
    gv_lock = 'X'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------
* These checks guard INSERT REPORT and all subsequent mutations.
* A normal report execution right is not development permission.
*---------------------------------------------------------------
FORM require_develop USING iv_type TYPE c iv_name TYPE c.
  DATA: lv_package LIKE tadir-devclass,
        lv_name LIKE tadir-obj_name.

  lv_name = iv_name.
  SELECT SINGLE devclass FROM tadir INTO lv_package
    WHERE pgmid = 'R3TR' AND object = iv_type
      AND obj_name = lv_name.
  IF sy-subrc <> 0.
    lv_package = '$TMP'.
  ENDIF.
  AUTHORITY-CHECK OBJECT 'S_DEVELOP'
    ID 'ACTVT' FIELD '02' ID 'DEVCLASS' FIELD lv_package
    ID 'OBJTYPE' FIELD iv_type ID 'OBJNAME' FIELD iv_name
    ID 'P_GROUP' DUMMY.
  IF sy-subrc <> 0.
    WRITE: / 'No S_DEVELOP change authorization:', iv_type, iv_name.
    gv_err = 'X'.
  ENDIF.
  AUTHORITY-CHECK OBJECT 'S_DEVELOP'
    ID 'ACTVT' FIELD '01' ID 'DEVCLASS' FIELD lv_package
    ID 'OBJTYPE' FIELD iv_type ID 'OBJNAME' FIELD iv_name
    ID 'P_GROUP' DUMMY.
  IF sy-subrc <> 0.
    WRITE: / 'No S_DEVELOP create authorization:', iv_type, iv_name.
    gv_err = 'X'.
  ENDIF.
  IF NOT p_del IS INITIAL.
    AUTHORITY-CHECK OBJECT 'S_DEVELOP'
      ID 'ACTVT' FIELD '06' ID 'DEVCLASS' FIELD lv_package
      ID 'OBJTYPE' FIELD iv_type ID 'OBJNAME' FIELD iv_name
      ID 'P_GROUP' DUMMY.
    IF sy-subrc <> 0.
      WRITE: / 'No S_DEVELOP delete authorization:', iv_name.
      gv_err = 'X'.
    ENDIF.
  ENDIF.
ENDFORM.

FORM check_authority.
  DATA: ls_dom TYPE ty_dom, ls_dtel TYPE ty_dtel,
        ls_tab TYPE ty_tab.

  PERFORM require_develop USING 'PROG' 'ZCHE_IMAP_COMMON'.
  PERFORM require_develop USING 'PROG' 'ZCHE_IMAP_IO'.
  PERFORM require_develop USING 'PROG' 'ZCHE_IMAP_HANDLER_DEMO'.
  PERFORM require_develop USING 'PROG' 'ZCHE_IMAP_INBOUND'.
  PERFORM require_develop USING 'PROG' 'ZCHE_IMAP_CONFIG'.
  PERFORM require_develop USING 'PROG' 'ZCHE_IMAP_MONITOR'.
  LOOP AT gt_dom INTO ls_dom.
    PERFORM require_develop USING 'DOMA' ls_dom-name.
  ENDLOOP.
  LOOP AT gt_dtel INTO ls_dtel.
    PERFORM require_develop USING 'DTEL' ls_dtel-name.
  ENDLOOP.
  LOOP AT gt_tab INTO ls_tab.
    PERFORM require_develop USING 'TABL' ls_tab-name.
  ENDLOOP.
ENDFORM.

* Dynamic access keeps the installer usable before DDIC exists.
FORM load_params.
  DATA: lv_table(30) TYPE c VALUE 'ZCHE_IMAP_PARAM',
        lv_name(30) TYPE c, lv_value(255) TYPE c.

  SELECT SINGLE tabname FROM dd02l INTO lv_name
    WHERE tabname = lv_table AND as4local = 'A'.
  IF sy-subrc <> 0.
    EXIT.
  ENDIF.
  SELECT SINGLE fieldname FROM dd03l INTO lv_name
    WHERE tabname = lv_table AND fieldname = 'PVALUE'
      AND as4local = 'A'.
  IF sy-subrc <> 0.
    gv_initerr = 'X'.
    EXIT.
  ENDIF.
  SELECT SINGLE fieldname FROM dd03l INTO lv_name
    WHERE tabname = lv_table AND fieldname = 'PARAM'
      AND as4local = 'A'.
  IF sy-subrc <> 0.
    gv_initerr = 'X'.
    EXIT.
  ENDIF.
  SELECT SINGLE pvalue FROM (lv_table) INTO lv_value
    WHERE param = 'ROOT'.
  IF sy-subrc = 0 AND NOT lv_value IS INITIAL.
    p_root = lv_value.
    IF p_root <> lv_value.
      gv_initerr = 'X'.
    ENDIF.
  ENDIF.
  CLEAR lv_value.
  SELECT SINGLE pvalue FROM (lv_table) INTO lv_value
    WHERE param = 'FILECP'.
  IF sy-subrc = 0 AND NOT lv_value IS INITIAL.
    p_cp = lv_value.
    IF lv_value = '65001'.
      p_mode = 'U'.
    ELSE.
      p_mode = 'L'.
    ENDIF.
  ENDIF.
  CLEAR lv_value.
  SELECT SINGLE pvalue FROM (lv_table) INTO lv_value
    WHERE param = 'EXEC_HOST'.
  IF sy-subrc = 0 AND NOT lv_value IS INITIAL
     AND lv_value <> sy-host.
    gv_initerr = 'X'.
  ENDIF.
ENDFORM.

FORM validate_root.
  DATA lv_chars(100) TYPE c.

  CONCATENATE 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
              '0123456789_-. /:\' INTO lv_chars.
  IF p_root IS INITIAL OR p_root CN lv_chars
     OR p_root CS '..'.
    WRITE: / 'Use an absolute server path without shell characters.'.
    gv_err = 'X'.
    EXIT.
  ENDIF.
  IF sy-opsys(7) = 'Windows'.
    IF p_root+1(2) <> ':\' AND p_root+1(2) <> ':/'.
      gv_err = 'X'.
    ENDIF.
  ELSEIF p_root(1) <> '/'.
    gv_err = 'X'.
  ENDIF.
  IF NOT gv_err IS INITIAL.
    WRITE: / 'Server folder must be an absolute local path.'.
  ENDIF.
ENDFORM.

